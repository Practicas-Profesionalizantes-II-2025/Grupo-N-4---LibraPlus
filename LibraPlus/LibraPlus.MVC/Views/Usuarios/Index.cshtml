@using LibraPlus.MVC.Models
@model List<UsuariosDTO>

@{
    ViewData["Title"] = "Administración de Usuarios - LibraPlus";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        /* ===== RESET ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #fdf6e3, #f8eed0);
            color: #4b3b2b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== HEADER ===== */
        header {
            background: linear-gradient(90deg, #d4a017, #e6b53f);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        header h1 {
            font-size: 24px;
            font-weight: bold;
        }

        header .btn-delete {
            background: #8b0000;
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            transition: background 0.3s ease;
            font-weight: bold;
        }

        header .btn-delete:hover {
            background: #5a0000;
        }

        /* ===== CONTENEDOR ===== */
        .container {
            flex: 1;
            max-width: 1100px;
            margin: 40px auto;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid #e6d8a2;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            color: #8b6b3f;
            font-size: 26px;
            margin-bottom: 25px;
        }

        /* ===== BOTÓN AGREGAR ===== */
        .add-user {
            display: block;
            margin: 0 auto 25px;
            background: #d4a017;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease, background 0.3s ease;
        }

        .add-user:hover {
            background: #b48a00;
            transform: scale(1.05);
        }

        /* ===== TABLA ===== */
        table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
            border-radius: 10px;
        }

        table thead th {
            background: #d4a017;
            color: white;
            text-align: left;
            padding: 14px;
            font-size: 15px;
        }

        table tbody td {
            padding: 12px;
            border-bottom: 1px solid #e6d8a2;
        }

        table tbody tr:hover {
            background: rgba(212, 160, 23, 0.08);
            transition: background 0.3s ease;
        }

        /* ===== BOTONES DE ACCIÓN ===== */
        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: transform 0.2s ease, background 0.3s ease;
        }

        .btn:hover {
            transform: scale(1.05);
        }

        .btn-edit {
            background: #d4a017;
            color: white;
        }

        .btn-edit:hover {
            background: #b48a00;
        }

        .btn-delete {
            background: #8b0000;
            color: white;
        }

        .btn-delete:hover {
            background: #5a0000;
        }

        /* ===== MODAL ===== */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(2px);
        }

        .modal-content {
            background: #fff8dc;
            padding: 25px;
            border-radius: 12px;
            width: 360px;
            max-width: 90%;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            position: relative;
            animation: fadeIn 0.3s ease;
        }

        

        .modal-content h3 {
            text-align: center;
            color: #8b6b3f;
            font-size: 20px;
            margin-bottom: 20px;
        }

        .modal-content input {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #c9b97e;
            border-radius: 8px;
            font-size: 14px;
            transition: border 0.2s, box-shadow 0.2s;
        }

        .modal-content input:focus {
            border-color: #b48a00;
            box-shadow: 0 0 6px #d4a017;
            outline: none;
        }

        .modal-actions {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .modal-actions button {
            flex: 1;
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: transform 0.2s ease, background 0.3s ease;
        }

        .modal-actions button:hover {
            transform: scale(1.05);
        }

        .modal-actions .save {
            background: #d4a017;
            color: white;
        }

        .modal-actions .save:hover {
            background: #b48a00;
        }

        .modal-actions .cancel {
            background: #8b0000;
            color: white;
        }

        .modal-actions .cancel:hover {
            background: #5a0000;
        }

        /* Botón cerrar modal */
        .close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background: none;
            border: none;
            font-size: 22px;
            cursor: pointer;
            color: #5a4634;
            transition: color 0.2s ease;
        }

        .close-btn:hover {
            color: #8b0000;
        }
    </style>
</head>

<body>
    <!-- ===== HEADER ===== -->
    <header>
        <h1>LibraPlus - Administración de Usuarios</h1>
        <a class="btn-delete" href="@Url.Action("Index", "Home")">Volver</a>
    </header>

    <!-- ===== CONTENIDO ===== -->
    <div class="container">
        <h2>Usuarios Registrados</h2>
        <button class="add-user" onclick="openModal('add')">+ Agregar Usuario</button>

        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Reputación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                @foreach (var usuario in Model)
                {
                    <tr data-id="@usuario.UsuarioId" 
                        data-nombre="@usuario.Nombre" 
                        data-email="@usuario.Email" 
                        data-reputacion="@usuario.Reputación">
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.Reputación</td>
                        <td>
                            <button class="btn btn-edit" onclick="openModal('edit', this)">Editar</button>
                            <button class="btn btn-delete" onclick="deleteUser(@usuario.UsuarioId, this)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ===== MODAL ===== -->
    <div class="modal" id="userModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">×</button>
            <h3 id="modalTitle">Agregar Usuario</h3>
            <form id="userForm">
                <input type="hidden" id="usuarioId" />
                <input type="text" id="usuarioNombre" placeholder="Nombre" required />
                <input type="email" id="usuarioEmail" placeholder="Correo electrónico" required />
                <input type="number" id="usuarioReputacion" placeholder="Reputación" required min="0" max="5" />

                @Html.AntiForgeryToken()

                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== SCRIPT ===== -->
    <script>
        const modal = document.getElementById('userModal');
        const modalTitle = document.getElementById('modalTitle');
        const form = document.getElementById('userForm');
        const inputId = document.getElementById('usuarioId');
        const inputNombre = document.getElementById('usuarioNombre');
        const inputEmail = document.getElementById('usuarioEmail');
        const inputReputacion = document.getElementById('usuarioReputacion');
        const tableBody = document.getElementById('userTableBody');

        function openModal(mode, button) {
            if (mode === 'add') {
                modalTitle.textContent = 'Agregar Usuario';
                form.dataset.mode = 'add';
                inputId.value = '';
                inputNombre.value = '';
                inputEmail.value = '';
                inputReputacion.value = '';
            } else if (mode === 'edit') {
                modalTitle.textContent = 'Editar Usuario';
                form.dataset.mode = 'edit';
                const row = button.closest('tr');
                inputId.value = row.dataset.id;
                inputNombre.value = row.dataset.nombre;
                inputEmail.value = row.dataset.email;
                inputReputacion.value = row.dataset.reputacion;
            }
            modal.style.display = 'flex';
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        window.onclick = function (event) {
            if (event.target === modal) closeModal();
        };

        // Utilidad: leer propiedad con fallback
        function prop(obj, key) {
            if (!obj) return undefined;
            if (key in obj) return obj[key];
            const lower = key.charAt(0).toLowerCase() + key.slice(1);
            if (lower in obj) return obj[lower];
            const upper = key.charAt(0).toUpperCase() + key.slice(1);
            if (upper in obj) return obj[upper];
            return undefined;
        }

        // Mostrar errores de ModelState
        function formatModelStateErrors(errObj) {
            try {
                if (typeof errObj === 'string') return errObj;
                let msgs = [];
                for (const k in errObj) {
                    const arr = errObj[k];
                    if (Array.isArray(arr)) msgs.push(`${k}: ${arr.join(', ')}`);
                    else msgs.push(`${k}: ${JSON.stringify(arr)}`);
                }
                return msgs.join('\n');
            } catch (e) { return JSON.stringify(errObj); }
        }

        // Guardar usuario
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const idRaw = (inputId.value || '').toString().trim();
            const id = idRaw ? parseInt(idRaw, 10) : 0;
            const reputacionRaw = (inputReputacion.value || '').toString().trim();
            const reputacionParsed = reputacionRaw ? parseInt(reputacionRaw, 10) : 0;

            const usuario = {
                UsuarioId: id,
                Nombre: (inputNombre.value || '').toString().trim(),
                Email: (inputEmail.value || '').toString().trim(),
                Reputación: reputacionParsed
            };

            let url = '@Url.Action("Create", "Usuarios")';
            let method = 'POST';

            if (form.dataset.mode === 'edit') {
                url = '@Url.Action("Edit", "Usuarios", new { id = "PLACEHOLDER_ID" })'.replace("PLACEHOLDER_ID", id);
            }

            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(usuario)
                });

                const text = await response.text();

                if (!response.ok) {
                    let parsed;
                    try { parsed = JSON.parse(text); } catch { parsed = text; }
                    const msg = formatModelStateErrors(parsed);
                    throw new Error(msg || ('HTTP ' + response.status));
                }

                let returned = null;
                if (text && text.length > 0) {
                    try { returned = JSON.parse(text); } catch { returned = text; }
                }

                if (form.dataset.mode === 'add') {
                    const u = returned || usuario;

                    const newId = prop(u, 'UsuarioId');
                    const newNombre = prop(u, 'Nombre');
                    const newEmail = prop(u, 'Email');
                    const newReputacion = prop(u, 'Reputación');

                    const tr = document.createElement('tr');
                    tr.dataset.id = newId;
                    tr.dataset.nombre = newNombre;
                    tr.dataset.email = newEmail;
                    tr.dataset.reputacion = newReputacion;

                    tr.innerHTML = `
                        <td>${newNombre}</td>
                        <td>${newEmail}</td>
                        <td>${newReputacion}</td>
                        <td>
                            <button class="btn btn-edit" onclick="openModal('edit', this)">Editar</button>
                            <button class="btn btn-delete" onclick="deleteUser(${newId}, this)">Eliminar</button>
                        </td>
                    `;
                    tableBody.appendChild(tr);

                } else if (form.dataset.mode === 'edit') {
                    const updated = returned || usuario;

                    const updatedId = prop(updated, 'UsuarioId');
                    const updatedNombre = prop(updated, 'Nombre');
                    const updatedEmail = prop(updated, 'Email');
                    const updatedReputacion = prop(updated, 'Reputación');

                    const row = tableBody.querySelector(`tr[data-id="${updatedId}"]`);
                    if (row) {
                        row.dataset.nombre = updatedNombre;
                        row.dataset.email = updatedEmail;
                        row.dataset.reputacion = updatedReputacion;

                        row.querySelector('td:nth-child(1)').textContent = updatedNombre;
                        row.querySelector('td:nth-child(2)').textContent = updatedEmail;
                        row.querySelector('td:nth-child(3)').textContent = updatedReputacion;
                    }
                }

                closeModal();

            } catch (err) {
                console.error('Error guardando usuario:', err);
                alert('Error al guardar el usuario:\n' + err.message);
            }
        });

        // Eliminar usuario
        async function deleteUser(id, button) {
            if (!confirm('¿Seguro que deseas eliminar este usuario?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const url = '@Url.Action("Delete", "Usuarios", new { id = "PLACEHOLDER_ID" })'.replace('PLACEHOLDER_ID', id);

                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/json'
                    }
                });

                const text = await response.text();
                if (!response.ok) {
                    let parsed;
                    try { parsed = JSON.parse(text); } catch { parsed = text; }
                    throw new Error(formatModelStateErrors(parsed) || ('HTTP ' + response.status));
                }

                const row = button.closest('tr');
                if (row) row.remove();

            } catch (err) {
                console.error('Error eliminando usuario:', err);
                alert('Error al eliminar el usuario:\n' + err.message);
            }
        }
    </script>
</body>
</html>