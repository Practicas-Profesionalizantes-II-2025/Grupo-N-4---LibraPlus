@{
    ViewData["Title"] = "Administración de Reseñas - LibraPlus";
    Layout = "_Layout";
}

<div class="container-beige">
    <h2 class="titulo">Reseñas</h2>
    <button class="btn-agregar" onclick="openModal()">+ Agregar Reseña</button>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Comentario</th>
                    <th>Puntuación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="reseniasTableBody"></tbody>
        </table>
    </div>
</div>

<!-- -------- MODAL -------- -->
<div class="modal" id="reseniaModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal()">×</button>
        <h3 id="modalTitle">Agregar Reseña</h3>
        <form id="reseniaForm">
            @Html.AntiForgeryToken()

            <select id="usuario" name="usuario" required>
                <option value="">Seleccione un Usuario</option>
            </select>

            <select id="libro" name="libro" required>
                <option value="">Seleccione un Libro</option>
            </select>

            <textarea id="comentario" name="comentario" placeholder="Comentario" rows="3"></textarea>
            <input type="number" id="puntuacion" name="puntuacion" placeholder="Puntuación (1-5)" min="1" max="5" required />

            <div class="modal-actions">
                <button type="submit" class="save">Guardar</button>
                <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('reseniaModal');
        const reseniaForm = document.getElementById('reseniaForm');
        const tableBody = document.getElementById('reseniasTableBody');
        const selectUsuario = document.getElementById('usuario');
        const selectLibro = document.getElementById('libro');

        let allResenias = [];
        let allUsuarios = [];
        let allLibros = [];

        function openModal() {
            modal.style.display = 'flex';
            reseniaForm.reset();
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        window.onclick = e => { if (e.target === modal) closeModal(); }

        function renderTable() {
            tableBody.innerHTML = '';
            allResenias.forEach(r => {
                const usuario = allUsuarios.find(u => u.usuarioId === r.usuarioID)?.nombre ?? 'Desconocido';
                const libro = allLibros.find(l => l.libroID === r.libroID)?.titulo ?? 'Desconocido';

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libro}</td>
                    <td>${r.comentario ?? ''}</td>
                    <td>${r.puntuacion} ⭐</td>
                    <td>
                        <button class="btn-return" onclick="deleteResenia(${r.reseniaID})">Eliminar</button>
                    </td>
                `;
                tableBody.appendChild(row);
            });
        }

        async function loadAllData() {
            try {
                // Usuarios
                allUsuarios = await (await fetch('/Usuarios/GetUsuarios')).json();
                selectUsuario.innerHTML = '<option value="">Seleccione un Usuario</option>';
                allUsuarios.forEach(u => {
                    const option = document.createElement('option');
                    option.value = u.usuarioId;
                    option.textContent = u.nombre;
                    selectUsuario.appendChild(option);
                });

                // Libros
                allLibros = await (await fetch('/Libros/GetLibros')).json();
                selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';
                allLibros.forEach(l => {
                    const option = document.createElement('option');
                    option.value = l.libroID;
                    option.textContent = l.titulo;
                    selectLibro.appendChild(option);
                });

                // Reseñas
                allResenias = await (await fetch('/Resenias/Lista')).json();
                renderTable();
            } catch (err) {
                console.error('Error cargando datos:', err);
                alert('Error al cargar datos.');
            }
        }

        reseniaForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const reseniaData = {
                UsuarioID: parseInt(selectUsuario.value),
                LibroID: parseInt(selectLibro.value),
                Comentario: document.getElementById('comentario').value,
                Puntuacion: parseInt(document.getElementById('puntuacion').value)
            };

            try {
                const response = await fetch('/Resenias/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0].value
                    },
                    body: JSON.stringify(reseniaData)
                });

                if (!response.ok) throw new Error(await response.text());

                await loadAllData();
                closeModal();
            } catch (err) {
                console.error('Error al crear reseña:', err);
                alert('Error al crear reseña: ' + err.message);
            }
        });

        async function deleteResenia(id) {
            if (!confirm('¿Seguro que desea eliminar la reseña?')) return;
            try {
                const response = await fetch(`/Resenias/Delete/${id}`, {
                    method: 'DELETE',
                    headers: { 'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0].value }
                });
                if (response.ok) {
                    allResenias = allResenias.filter(r => r.reseniaID !== id);
                    renderTable();
                } else {
                    throw new Error('No se pudo eliminar la reseña.');
                }
            } catch (err) {
                console.error('Error al eliminar:', err);
                alert('Error al eliminar reseña: ' + err.message);
            }
        }

        loadAllData();
    </script>
}
