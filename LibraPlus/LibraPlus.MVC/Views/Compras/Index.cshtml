@model List<ComprasDTO>
@{
    ViewData["Title"] = "Administración de Compras - LibraPlus";
    Layout = "_Layout"; 
    var isAdmin = User.IsInRole("Admin");
}

<form id="tokenForm">
    @Html.AntiForgeryToken()
</form>

<style>
    /* ----------- MODAL DE RESUMEN ----------- */
    #summaryModal .modal-content {
        width: auto;
        max-width: 90%;
        min-width: 400px;
        padding: 20px;
        background: #fff8dc;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        position: relative;
    }

    #summaryModal table th {
        background: #d4a017;
        color: white;
        text-align: center;
        padding: 10px;
    }

    #summaryModal table td {
        padding: 10px;
        text-align: center;
        border-bottom: 1px solid #e6d8a2;
    }

    .libro-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .filter-input, .filter-select {
        padding: 6px 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 14px;
    }
</style>

<div class="container-beige">
    <h2 class="titulo">🛒 Historial de Compras</h2>

    <div class="filters-bar">
        <div class="filter-left">
            <button class="btn-return" onclick="mostrarResumen()">📊 Ver Resumen</button>
        </div>
        <div class="filter-right">
            <input type="text" id="filterName" placeholder="🔍 Filtrar por libro...">
            <select id="filterType">
                <option value="">Todos los tipos</option>
                <option value="Digital">Digital</option>
                <option value="Físico">Físico</option>
            </select>
            <button class="btn-agregar" onclick="openModal()">➕ Registrar Compra</button>
        </div>
    </div>

    <div class="table-container">
        <table class="lp-table">
            <thead>
                <tr>
                    <th>👤 Usuario</th>
                    <th>📘 Libro</th>
                    <th>📅 Fecha</th>
                    <th>💰 Precio</th>
                    <th>📱 Tipo</th>
                    <th>🔗 URL Descarga</th>
                </tr>
            </thead>
            <tbody id="purchaseTableBody"></tbody>
        </table>
    </div>
</div>

<div class="modal" id="purchaseModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal()">×</button>
        <h3>Registrar Compra</h3>
        <form id="purchaseForm">
            @if (isAdmin)
            {
                <select id="usuario" required>
                    <option value="">Seleccione un Usuario</option>
                </select>
            }
            else
            {
                <input type="hidden" id="usuario" value="@User.FindFirst("Id")?.Value" />
            }

            <div class="libro-filters">
                <input type="text" id="filtroTitulo" placeholder="Buscar libro..." class="filter-input">
                <select id="filtroGenero" class="filter-select">
                    <option value="">Todos los géneros</option>
                    <option value="Fantasia">Fantasía</option>
                    <option value="Ciencia ficción">Ciencia ficción</option>
                    <option value="Novela">Novela</option>
                    <option value="Comic">Comic</option>
                </select>
                <select id="filtroTipo" class="filter-select">
                    <option value="">Todos los tipos</option>
                    <option value="Físico">Físico</option>
                    <option value="Digital">Digital</option>
                </select>
            </div>

            <select id="libro" required>
                <option value="">Seleccione un Libro</option>
            </select>

            <div class="modal-actions">
                <button type="submit" class="save">💾 Guardar</button>
                <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
            </div>
        </form>

    </div>
</div>

<div class="modal" id="summaryModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeSummaryModal()">×</button>
        <h3>Resumen de Compras por Usuario</h3>
        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Cantidad de Libros Comprados</th>
                </tr>
            </thead>
            <tbody id="summaryTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ Elementos del DOM
        const modal = document.getElementById('purchaseModal');
        const purchaseForm = document.getElementById('purchaseForm');
        const tableBody = document.getElementById('purchaseTableBody');
        const selectUsuario = document.getElementById('usuario');
        const selectLibro = document.getElementById('libro');
        const filterNameInput = document.getElementById('filterName');
        const filterTypeSelect = document.getElementById('filterType');

        let allCompras = [];
        let allUsuarios = [];
        let allLibros = [];

        // 🔹 Abrir y cerrar modal
        function openModal() {
            modal.style.display = 'flex';
            purchaseForm.reset();
            // Asegurar que el select de libros se renderiza con todos los libros al abrir
            filtrarLibros();
        }
        function closeModal() { modal.style.display = 'none'; }
        window.onclick = e => { if (e.target === modal) closeModal(); }

        // 🔹 Cargar usuarios y libros desde la API
        async function loadUsuariosYLibros() {
            try {
                // Usuarios
                const isAdmin = @isAdmin.ToString().ToLower();
                if (isAdmin) {
                    allUsuarios = await (await fetch('/Compras/GetUsuarios')).json();
                    selectUsuario.innerHTML = '<option value="">Seleccione un Usuario</option>';
                    allUsuarios.forEach(u => {
                        const opt = document.createElement('option');
                        opt.value = u.usuarioId;
                        opt.textContent = u.nombre;
                        selectUsuario.appendChild(opt);
                    });
                }

                // Libros
                allLibros = await (await fetch('/Compras/GetLibros')).json();
                selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';
                // Inicialmente llenar el select sin filtros
                allLibros.forEach(l => {
                    const opt = document.createElement('option');
                    opt.value = l.libroID;
                    opt.textContent = `${l.titulo} - ${l.autor} (${l.tipo})`;
                    selectLibro.appendChild(opt);
                });
            } catch (err) {
                console.error('Error cargando usuarios o libros:', err);
                alert('Error al cargar usuarios o libros.');
            }
        }

        // 🔹 Cargar compras
        async function loadCompras() {
            try {
                allCompras = await (await fetch('/Compras/Lista')).json();
                renderTable();
            } catch (err) {
                console.error('Error cargando compras:', err);
            }
        }

        // 🔹 Renderizar tabla
        function renderTable() {
            tableBody.innerHTML = '';
            // Se necesita la lista de usuarios para renderizar el nombre, si aún no está cargada (ej. si no es Admin), se intenta cargar o se usa el ID.
            if (allUsuarios.length === 0 && @isAdmin.ToString().ToLower()) {
                 // Si es Admin y no hay usuarios, se espera que loadUsuariosYLibros se haya llamado
            } else if (allUsuarios.length === 0 && !@isAdmin.ToString().ToLower()) {
                // Si no es Admin, el nombre de usuario de las compras propias debería ser el del usuario logueado.
                // Para el propósito de esta función que itera *todas* las compras, asumiremos que si no es Admin, solo se muestran sus propias compras.
                // Sin embargo, para que el resumen funcione con "Desconocido" si la lista global está vacía, no haremos nada.
            }

            allCompras.forEach(c => {
                const usuario = allUsuarios.find(u => u.usuarioId === c.usuarioID)?.nombre ?? 'Desconocido';
                const libro = allLibros.find(l => l.libroID === c.libroID);
                const libroTitulo = libro?.titulo ?? 'Desconocido';
                const tipo = libro?.tipo ?? 'Desconocido';
                const fecha = new Date(c.fecha).toLocaleDateString();

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libroTitulo}</td>
                    <td>${fecha}</td>
                    <td>$${c.precio.toFixed(2)}</td>
                    <td>${tipo}</td>
                    <td>
                        ${
                            c.descargaURL
                            ? `<button class="show-url" onclick="toggleUrl(this, '${c.descargaURL}')">Ver URL</button>
                               <span class="hidden-url" style="display:none;">${c.descargaURL}</span>`
                            : 'N/A'
                        }
                    </td>
                `;
                tableBody.appendChild(row);
            });

            applyFilters();
        }

        // 🔹 Filtrar libros para el modal de registro
        function filtrarLibros() {
            const texto = document.getElementById('filtroTitulo').value.toLowerCase();
            const genero = document.getElementById('filtroGenero').value.toLowerCase();
            const tipo = document.getElementById('filtroTipo').value.toLowerCase();

            const selectLibro = document.getElementById('libro');
            selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';

            allLibros
                .filter(l =>
                    (!texto || l.titulo.toLowerCase().includes(texto) || l.autor.toLowerCase().includes(texto)) &&
                    (!genero || (l.genero && l.genero.toLowerCase() === genero)) &&
                    (!tipo || (l.tipo && l.tipo.toLowerCase() === tipo))
                )
                .forEach(l => {
                    const opt = document.createElement('option');
                    opt.value = l.libroID;
                    opt.textContent = `${l.titulo} - ${l.autor} (${l.tipo})`;
                    selectLibro.appendChild(opt);
                });
        }

        // Escuchar eventos de filtro del MODAL (filtroTitulo, filtroGenero, filtroTipo)
        document.getElementById('filtroTitulo').addEventListener('input', filtrarLibros);
        document.getElementById('filtroGenero').addEventListener('change', filtrarLibros);
        document.getElementById('filtroTipo').addEventListener('change', filtrarLibros);

        // 🔹 Registrar compra (con URL aleatoria)
        purchaseForm.addEventListener('submit', async e => {
            e.preventDefault();

            // Determinar UsuarioID
            let UsuarioID;
            if (@isAdmin.ToString().ToLower()) {
                // Admin: usar select
                UsuarioID = parseInt(selectUsuario.value);
            } else {
                // Usuario normal: usar hidden
                const hiddenInput = document.getElementById('usuario');
                UsuarioID = parseInt(hiddenInput?.value);
            }

            const LibroID = parseInt(selectLibro.value);
            const libroSeleccionado = allLibros.find(l => l.libroID === LibroID);

            if (isNaN(UsuarioID) || isNaN(LibroID)) {
                alert('Debe seleccionar un usuario y un libro válidos.');
                return;
            }

            // Validar que el libro tenga un precio para enviarlo en el DTO (asumiendo que el DTO en el backend lo requiere)
            if (!libroSeleccionado || libroSeleccionado.precio === undefined) {
                 alert('Error: No se encontró la información de precio para el libro seleccionado.');
                 return;
            }

            // ✅ Generar URL aleatoria al crear la compra
            let descargaURL = null;
            if (libroSeleccionado.tipo === "Digital") {
                const random = Math.random().toString(36).substring(2, 10);
                descargaURL = `https://descargas.libraplus.com/${random}`;
            }

            try {
                const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;
                const response = await fetch('/Compras/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    // Se agrega el precio (asumiendo que el DTO del backend lo requiere del objeto Libro)
                    body: JSON.stringify({
                        UsuarioID: UsuarioID,
                        LibroID: LibroID,
                        DescargaURL: descargaURL,
                        Precio: libroSeleccionado.precio // Se añade el precio del libro
                    })
                });

                const result = await response.json();
                if (result.success) {
                    allCompras.push(result.compra);
                    renderTable();
                    closeModal();
                    // Limpiar filtros del modal
                    document.getElementById('filtroTitulo').value = '';
                    document.getElementById('filtroGenero').value = '';
                    document.getElementById('filtroTipo').value = '';
                } else {
                    alert('Error al registrar la compra: ' + (result.mensaje || 'desconocido'));
                }
            } catch (err) {
                console.error('Error al registrar compra:', err);
                alert('Error al registrar la compra: ' + err.message);
            }
        });

        // 🔹 Mostrar u ocultar URL de descarga
        function toggleUrl(button, url) {
            const span = button.nextElementSibling;
            if (span.style.display === "none") {
                span.style.display = "inline";
                button.textContent = "Ocultar URL";
            } else {
                span.style.display = "none";
                button.textContent = "Ver URL";
            }
        }

        // Hacer la función 'toggleUrl' globalmente accesible
        window.toggleUrl = toggleUrl;


        // 🔹 Mostrar modal de resumen
        function mostrarResumen() {
            const summaryModal = document.getElementById('summaryModal');
            const summaryTableBody = document.getElementById('summaryTableBody');
            summaryTableBody.innerHTML = '';

            if (allCompras.length === 0) {
                summaryTableBody.innerHTML = `<tr><td colspan="2" style="text-align:center;">No hay compras registradas</td></tr>`;
                summaryModal.style.display = 'flex';
                return;
            }

            const resumen = {};
            allCompras.forEach(c => {
                resumen[c.usuarioID] = (resumen[c.usuarioID] || 0) + 1;
            });

            Object.entries(resumen).forEach(([usuarioID, cantidad]) => {
                const usuario = allUsuarios.find(u => u.usuarioId === parseInt(usuarioID))?.nombre ?? 'Desconocido';
                const row = document.createElement('tr');
                row.innerHTML = `<td>${usuario}</td><td style="text-align:center;">${cantidad}</td>`;
                summaryTableBody.appendChild(row);
            });

            summaryModal.style.display = 'flex';
        }
        // Hacer la función 'mostrarResumen' globalmente accesible
        window.mostrarResumen = mostrarResumen;


        // 🔹 Cerrar modal de resumen
        function closeSummaryModal() {
            const summaryModal = document.getElementById('summaryModal');
            summaryModal.style.display = 'none';
        }
        // Hacer la función 'closeSummaryModal' globalmente accesible
        window.closeSummaryModal = closeSummaryModal;

        // 🔹 Filtros de la tabla principal
        function applyFilters() {
            const nameFilter = filterNameInput.value.toLowerCase();
            const typeFilter = filterTypeSelect.value;
            document.querySelectorAll('#purchaseTableBody tr').forEach(row => {
                // Libro está en la columna 2 (índice 1)
                const bookName = row.children[1].textContent.toLowerCase();
                // Tipo está en la columna 5 (índice 4)
                const bookType = row.children[4].textContent;

                // Muestra la fila si el nombre incluye el filtro Y el tipo coincide (o el filtro de tipo está vacío)
                row.style.display = (bookName.includes(nameFilter) && (typeFilter === "" || bookType === typeFilter)) ? "" : "none";
            });
        }
        filterNameInput.addEventListener('input', applyFilters);
        filterTypeSelect.addEventListener('change', applyFilters);

        // 🔹 Inicializar todo
        document.addEventListener('DOMContentLoaded', async () => {
            await loadUsuariosYLibros();
            await loadCompras();
        });
    </script>
}