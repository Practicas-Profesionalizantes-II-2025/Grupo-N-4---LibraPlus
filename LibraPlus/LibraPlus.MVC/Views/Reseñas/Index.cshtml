@{
    ViewData["Title"] = "Administración de Reseñas - LibraPlus";
    Layout = "_Layout";
    var isAdmin = User.IsInRole("Admin");
    var usuarioLogueadoId = User.FindFirst("Id")?.Value ?? "0";
}

<div class="container-beige">
    <h2 class="titulo">Reseñas</h2>

    @* Solo usuarios normales pueden agregar reseñas *@
    @if (!isAdmin)
    {
        <button class="btn-agregar" onclick="openModal()">+ Agregar Reseña</button>
    }

    <!-- ✅ FILTROS -->
    <div class="filtros">
        <input type="text" id="filtroUsuario" placeholder="Buscar por Usuario...">
        <input type="text" id="filtroLibro" placeholder="Buscar por Libro...">
        <select id="filtroPuntuacion">
            <option value="">Puntuación</option>
            <option value="1">1 ⭐</option>
            <option value="2">2 ⭐⭐</option>
            <option value="3">3 ⭐⭐⭐</option>
            <option value="4">4 ⭐⭐⭐⭐</option>
            <option value="5">5 ⭐⭐⭐⭐⭐</option>
        </select>
        <button class="btn-return" onclick="limpiarFiltros()">Limpiar</button>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Comentario</th>
                    <th>Puntuación</th>
                    @if (isAdmin)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody id="reseñasTableBody"></tbody>
        </table>
    </div>
</div>

@* Modal solo para usuarios normales *@
@if (!isAdmin)
{
    <div class="modal" id="reseñaModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">×</button>
            <h3 id="modalTitle">Agregar Reseña</h3>
            <form id="reseñaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="usuario" value="@usuarioLogueadoId" />

                <select id="libro" required>
                    <option value="">Seleccione un Libro</option>
                </select>

                <textarea id="comentario" placeholder="Comentario" rows="3"></textarea>
                <input type="number" id="puntuacion" placeholder="Puntuación (1-5)" min="1" max="5" required />

                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        const tableBody = document.getElementById('reseñasTableBody');
        let allReseñas = [];
        let allLibros = [];

        const esAdmin = @((isAdmin ? "true" : "false"));
        const usuarioLogueadoId = parseInt("@usuarioLogueadoId");

        // ====== CARGA DE DATOS ======
        async function loadAllData() {
            try {
                const [librosResp, reseñasResp] = await Promise.all([
                    fetch('/Libros/GetLibros'),
                    fetch('/Reseñas/Lista')
                ]);

                allLibros = await librosResp.json();
                allReseñas = await reseñasResp.json();

                renderTable();
            } catch (err) {
                showToast("❌ Error al cargar datos: " + err.message, "error");
            }
        }

        // ====== RENDER TABLA con FILTROS ======
        function renderTable() {
            tableBody.innerHTML = '';

            // Obtenemos filtro actual
            const fUsuario = document.getElementById('filtroUsuario').value.toLowerCase();
            const fLibro = document.getElementById('filtroLibro').value.toLowerCase();
            const fPuntuacion = document.getElementById('filtroPuntuacion').value;

            let filtradas = allReseñas.filter(r => {
                const usuario = (r.usuarioNombre ?? "").toLowerCase();
                const libro = (allLibros.find(l => l.libroID === r.libroID)?.titulo ?? "").toLowerCase();

                return (!fUsuario || usuario.includes(fUsuario))
                    && (!fLibro || libro.includes(fLibro))
                    && (!fPuntuacion || r.puntuacion == fPuntuacion);
            });

            if (filtradas.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="${esAdmin ? 5 : 4}" style="text-align:center;">No hay resultados.</td></tr>`;
                return;
            }

            filtradas.forEach(r => {
                const libro = allLibros.find(l => l.libroID === r.libroID)?.titulo ?? 'Desconocido';
                const usuario = r.usuarioNombre ?? 'Desconocido';

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libro}</td>
                    <td>${r.comentario ?? ''}</td>
                    <td>${r.puntuacion} ⭐</td>
                    ${esAdmin ? `<td><button class="btn-return" onclick="deleteReseña(${r.reseñaID})">Eliminar</button></td>` : ''}
                `;
                tableBody.appendChild(row);
            });
        }

        // ✅ Filtros activos en tiempo real
        document.getElementById('filtroUsuario').addEventListener('input', renderTable);
        document.getElementById('filtroLibro').addEventListener('input', renderTable);
        document.getElementById('filtroPuntuacion').addEventListener('change', renderTable);

        function limpiarFiltros() {
            document.getElementById('filtroUsuario').value = "";
            document.getElementById('filtroLibro').value = "";
            document.getElementById('filtroPuntuacion').value = "";
            renderTable();
        }

        // ====== MODAL Y CREACIÓN ======
        if (!esAdmin) {
            const modal = document.getElementById('reseñaModal');
            const reseñaForm = document.getElementById('reseñaForm');

            function openModal() {
                modal.classList.add("show");
                reseñaForm.reset();

                const selectLibro = document.getElementById('libro');
                selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';
                allLibros.forEach(l => {
                    const option = document.createElement('option');
                    option.value = l.libroID;
                    option.textContent = l.titulo;
                    selectLibro.appendChild(option);
                });
            }

            function closeModal() { modal.classList.remove("show"); }
            window.onclick = e => { if (e.target === modal) closeModal(); }

            reseñaForm.addEventListener('submit', async e => {
                e.preventDefault();

                const reseñaData = {
                    usuarioID: usuarioLogueadoId,
                    libroID: parseInt(document.getElementById('libro').value),
                    comentario: document.getElementById('comentario').value,
                    puntuacion: parseInt(document.getElementById('puntuacion').value)
                };

                const token = document.getElementsByName('__RequestVerificationToken')[0].value;

                try {
                    const response = await fetch('/Reseñas/Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(reseñaData)
                    });

                    if (!response.ok) throw new Error(await response.text());
                    await loadAllData();
                    closeModal();
                    showToast("✅ Reseña agregada correctamente");
                } catch (err) {
                    showToast("❌ " + err.message, "error");
                }
            });
        }

        // ====== ELIMINAR ======
        async function deleteReseña(id) {
            if (!confirm("¿Eliminar reseña? Esta acción no se puede deshacer.")) return;

            try {
                const response = await fetch(`/Reseñas/Delete/${id}`, { method: "DELETE" });
                if (!response.ok) throw new Error("No se pudo eliminar.");
                allReseñas = allReseñas.filter(r => r.reseñaID !== id);
                renderTable();
                showToast("✅ Reseña eliminada");
            } catch (err) {
                showToast("❌ " + err.message, "error");
            }
        }

        // ====== TOAST ======
        function showToast(message, type = "success") {
            const toast = document.createElement("div");
            toast.className = "toast " + (type === "error" ? "error" : "");
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.classList.add("show"), 100);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', loadAllData);
    </script>
}