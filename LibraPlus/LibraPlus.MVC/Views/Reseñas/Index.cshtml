@{
    ViewData["Title"] = "Administración de Reseñas - LibraPlus";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --brand: #d4a017;
            --ink: #5a4634;
            --bg: #fdf6e3;
            --accent: #8b6b3f;
            --danger: #8b0000;
            --danger-dark: #5a0000;
        }

        html {
            font-size: 14px;
            position: relative;
            min-height: 100%;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        header {
            background: var(--brand);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

            header h1 {
                font-size: 22px;
            }

            header .logout {
                background: var(--danger);
                border: none;
                padding: 8px 14px;
                border-radius: 8px;
                color: white;
                cursor: pointer;
                font-weight: bold;
                transition: background .3s;
            }

                header .logout:hover {
                    background: var(--danger-dark);
                }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            background: rgba(255, 248, 220, 0.95);
            border: 2px solid #e6d8a2;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        h2 {
            text-align: center;
            color: var(--accent);
            margin-bottom: 20px;
        }

        .add-review {
            display: block;
            margin: 0 auto 20px;
            background: var(--accent);
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            width: fit-content;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: bold;
            border: none;
        }

            .add-review:hover {
                background: #704d25;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

            table th, table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #e6d8a2;
            }

            table th {
                background: var(--brand);
                color: white;
            }

            table tr:hover {
                background: rgba(212, 160, 23, 0.1);
            }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s;
        }

        .btn-edit {
            background: var(--brand);
            color: white;
        }

            .btn-edit:hover {
                background: #b48a00;
            }

        .btn-delete {
            background: var(--danger);
            color: white;
        }

            .btn-delete:hover {
                background: var(--danger-dark);
            }

        /* --- MODAL --- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: #fff8dc;
            padding: 20px;
            border-radius: 10px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            position: relative;
            box-sizing: border-box;
        }

            .modal-content h3 {
                text-align: center;
                color: var(--accent);
                margin-bottom: 15px;
            }

            .modal-content input,
            .modal-content select,
            .modal-content textarea {
                width: 100%;
                box-sizing: border-box;
                padding: 10px;
                margin-bottom: 15px;
                border: 1px solid #c9b97e;
                border-radius: 8px;
                font-size: 14px;
            }

                .modal-content input:focus,
                .modal-content select:focus,
                .modal-content textarea:focus {
                    outline: none;
                    border-color: #b48a00;
                    box-shadow: 0 0 5px #b48a00;
                }

            .modal-content .modal-actions {
                display: flex;
                justify-content: space-between;
                gap: 10px;
            }

            .modal-content button {
                flex: 1;
                padding: 10px;
                border: none;
                border-radius: 8px;
                font-weight: bold;
                cursor: pointer;
            }

            .modal-content .save {
                background: var(--brand);
                color: white;
            }

                .modal-content .save:hover {
                    background: #b48a00;
                }

            .modal-content .cancel {
                background: var(--danger);
                color: white;
            }

                .modal-content .cancel:hover {
                    background: var(--danger-dark);
                }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: var(--ink);
        }

            .close-btn:hover {
                color: var(--danger);
            }
    </style>
</head>
<body>
    <header>
        <h1>LibraPlus - Administración de Reseñas</h1>
        <button class="logout">Cerrar sesión</button>
    </header>

    <div class="container">
        <h2>Lista de Reseñas</h2>
        <button class="add-review" onclick="openModal()">+ Agregar Reseña</button>

        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Comentario</th>
                    <th>Puntuación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="reviewTableBody"></tbody>
        </table>
    </div>

    <!-- Modal -->
    <div class="modal" id="reviewModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">×</button>
            <h3 id="modalTitle">Agregar Reseña</h3>
            <form id="reviewForm">
                <input type="hidden" id="editIndex">

                <select id="usuario" name="usuario" required>
                    <option value="">Seleccione un Usuario</option>
                    <option value="1">Juan Pérez</option>
                    <option value="2">Ana López</option>
                </select>

                <select id="libro" name="libro" required>
                    <option value="">Seleccione un Libro</option>
                    <option value="1">El Principito</option>
                    <option value="2">1984</option>
                </select>

                <textarea id="comentario" name="comentario" placeholder="Comentario" rows="3"></textarea>
                <input type="number" id="puntuacion" name="puntuacion" placeholder="Puntuación (1-5)" min="1" max="5" required>

                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('reviewModal');
        const reviewForm = document.getElementById('reviewForm');
        const tableBody = document.getElementById('reviewTableBody');
        const modalTitle = document.getElementById('modalTitle');

        function openModal(isEdit = false, index = null) {
            modal.style.display = 'flex';
            modalTitle.textContent = isEdit ? 'Editar Reseña' : 'Agregar Reseña';
            if (!isEdit) {
                reviewForm.reset();
                document.getElementById('editIndex').value = '';
            } else {
                document.getElementById('editIndex').value = index;
            }
        }

        function closeModal() { modal.style.display = 'none'; }

        window.onclick = function(e) { if (e.target === modal) closeModal(); }

        reviewForm.addEventListener('submit', function(e){
            e.preventDefault();
            const usuario = document.getElementById('usuario').selectedOptions[0].text;
            const libro = document.getElementById('libro').selectedOptions[0].text;
            const comentario = document.getElementById('comentario').value || '';
            const puntuacion = document.getElementById('puntuacion').value;
            const editIndex = document.getElementById('editIndex').value;

            if(editIndex === '') {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libro}</td>
                    <td>${comentario}</td>
                    <td>${puntuacion}</td>
                    <td>
                        <button type="button" class="btn btn-edit" onclick="editRow(this)">Editar</button>
                        <button type="button" class="btn btn-delete" onclick="deleteRow(this)">Eliminar</button>
                    </td>`;
                tableBody.appendChild(row);
            } else {
                const row = tableBody.children[editIndex];
                row.cells[0].textContent = usuario;
                row.cells[1].textContent = libro;
                row.cells[2].textContent = comentario;
                row.cells[3].textContent = puntuacion;
            }
            closeModal();
            reviewForm.reset();
        });

        function editRow(button){
            const row = button.closest('tr');
            const index = Array.from(tableBody.children).indexOf(row);
            document.getElementById('usuario').value = row.cells[0].textContent === 'Juan Pérez' ? '1' : '2';
            document.getElementById('libro').value = row.cells[1].textContent === 'El Principito' ? '1' : '2';
            document.getElementById('comentario').value = row.cells[2].textContent;
            document.getElementById('puntuacion').value = row.cells[3].textContent;
            openModal(true,index);
        }

        function deleteRow(button){
            if(confirm('¿Seguro que desea eliminar esta reseña?')){
                const row = button.closest('tr');
                tableBody.removeChild(row);
            }
        }
    </script>
</body>
</html>
