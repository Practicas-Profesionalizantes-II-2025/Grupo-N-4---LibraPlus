@model List<PrestamosDTO>
@{
    ViewData["Title"] = "Gestión de Préstamos";
    Layout = "_Layout";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-beige">
    <h2 class="titulo">📚 Préstamos</h2>
    <button class="btn-agregar" onclick="openModal()">+ Registrar Préstamo</button>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Libro</th>
                    <th>Usuario</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Devuelto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="prestamosTableBody"></tbody>
        </table>
    </div>
</div>

<!-- -------- MODAL -------- -->
<div class="modal" id="prestamoModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal()">×</button>
        <h3 id="modalTitle">Registrar Préstamo</h3>
        <form id="prestamoForm">
            @Html.AntiForgeryToken()

            @if (isAdmin)
            {
                <select id="usuario" required>
                    <option value="">Seleccione un Usuario</option>
                </select>
            }
            else
            {
                <input type="hidden" id="usuario" value="@User.FindFirst("Id")?.Value" />
            }

            <select id="libro" required>
                <option value="">Seleccione un Libro</option>
            </select>

            <input type="date" id="fechaFin" required />

            <div class="modal-actions">
                <button type="submit" class="save">Guardar</button>
                <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE = "https://localhost:7290/api";

        const modal = document.getElementById('prestamoModal');
        const prestamoForm = document.getElementById('prestamoForm');
        const tableBody = document.getElementById('prestamosTableBody');
        const selectLibro = document.getElementById('libro');
        const selectUsuario = document.getElementById('usuario');

        let allPrestamos = [];
        let allLibros = [];
        let allUsuarios = [];

        // === Abrir / cerrar modal ===
        function openModal() {
            modal.classList.add("show");
            prestamoForm.reset();
        }

        function closeModal() {
            modal.classList.remove("show");
        }

        window.onclick = e => { if (e.target === modal) closeModal(); }

        // === Renderizar tabla ===
        function renderTable() {
            tableBody.innerHTML = '';
            allPrestamos.forEach(p => {
                const libro = allLibros.find(l => l.LibroID === p.LibroID)?.Titulo ?? 'Desconocido';
                const usuario = allUsuarios.find(u => u.UsuarioID === p.UsuarioID)?.Nombre ?? `ID ${p.UsuarioID}`;
                const fechaInicio = new Date(p.FechaInicio).toLocaleDateString();
                const fechaFin = new Date(p.FechaFin).toLocaleDateString();

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${libro}</td>
                    <td>${usuario}</td>
                    <td>${fechaInicio}</td>
                    <td>${fechaFin}</td>
                    <td>${p.Devuelto ? "✔️" : "❌"}</td>
                    <td>
                        ${!p.Devuelto ? `<button class="btn-return" onclick="devolverPrestamo(${p.PrestamoID})">Devolver</button>` : ""}
                    </td>
                `;
                tableBody.appendChild(row);
            });
        }

        // === Cargar datos de API ===
        async function loadAllData() {
            try {
                const [librosResp, usuariosResp, prestamosResp] = await Promise.all([
                    fetch(`${API_BASE}/Libros`),
                    fetch(`${API_BASE}/Usuarios`),
                    fetch(`${API_BASE}/Prestamos`)
                ]);

                if (!librosResp.ok || !usuariosResp.ok || !prestamosResp.ok)
                    throw new Error('Error al cargar datos de la API');

                allLibros = await librosResp.json();
                allUsuarios = await usuariosResp.json();
                allPrestamos = await prestamosResp.json();

                // Llenar combo de libros (solo físicos con stock)
                selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';
                allLibros
                    .filter(l => l.Tipo === "Físico" && l.Stock > 0)
                    .forEach(l => {
                        const option = document.createElement('option');
                        option.value = l.LibroID;
                        option.textContent = l.Titulo;
                        selectLibro.appendChild(option);
                    });

                // Llenar combo de usuarios solo si es admin
                if (@isAdmin.ToString().ToLower()) {
                    selectUsuario.innerHTML = '<option value="">Seleccione un Usuario</option>';
                    allUsuarios.forEach(u => {
                        const option = document.createElement('option');
                        option.value = u.UsuarioID;
                        option.textContent = u.Nombre;
                        selectUsuario.appendChild(option);
                    });
                }

                renderTable();
            } catch (err) {
                console.error('❌ Error cargando datos:', err);
                alert('Error al cargar datos: ' + err.message);
            }
        }

        // === Crear nuevo préstamo ===
        prestamoForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            let UsuarioID;
            if (@isAdmin.ToString().ToLower()) {
                UsuarioID = parseInt(selectUsuario.value);
            } else {
                UsuarioID = parseInt(document.getElementById('usuario').value);
            }

            const LibroID = parseInt(selectLibro.value);
            const FechaFin = document.getElementById('fechaFin').value;

            if (isNaN(UsuarioID) || isNaN(LibroID) || !FechaFin) {
                alert('Faltan datos para crear el préstamo.');
                return;
            }

            const prestamoData = { UsuarioID, LibroID, FechaFin };

            try {
                const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;
                const response = await fetch(`${API_BASE}/Prestamos`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(prestamoData)
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText);
                }

                const nuevoPrestamo = await response.json();
                allPrestamos.push(nuevoPrestamo);
                renderTable();
                closeModal();
                alert('📚 Préstamo registrado correctamente');
            } catch (err) {
                console.error('❌ Error al crear préstamo:', err);
                alert('Error al crear préstamo: ' + err.message);
            }
        });

        // === Devolver préstamo ===
        async function devolverPrestamo(id) {
            try {
                const response = await fetch(`${API_BASE}/Prestamos/${id}/devolver`, { method: 'PUT' });
                if (!response.ok) throw new Error('No se pudo marcar como devuelto.');

                allPrestamos = allPrestamos.map(p =>
                    p.PrestamoID === id ? { ...p, Devuelto: true } : p
                );

                renderTable();
                alert('✅ Libro devuelto correctamente');
            } catch (err) {
                console.error('❌ Error al devolver préstamo:', err);
                alert('Error al devolver préstamo: ' + err.message);
            }
        }

        // === Inicialización ===
        document.addEventListener('DOMContentLoaded', loadAllData);
    </script>
}
