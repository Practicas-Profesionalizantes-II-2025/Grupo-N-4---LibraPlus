@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - LibraPlus</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: url("") no-repeat center center fixed;
            background-size: cover;
        }

        .login-container {
            background: rgba(255, 248, 220, 0.95);
            border: 2px solid #e6d8a2;
            border-radius: 15px;
            box-shadow: 0px 4px 15px rgba(0,0,0,0.3);
            padding: 40px;
            width: 350px;
            text-align: center;
        }

            .login-container h1 {
                margin: 0 0 10px;
                color: #8b6b3f;
                font-size: 28px;
            }

            .login-container h2 {
                margin-bottom: 25px;
                color: #5a4634;
                font-size: 20px;
            }

            .login-container input {
                width: 100%;
                padding: 12px;
                margin: 10px 0;
                border: 1px solid #c9b97e;
                border-radius: 8px;
                font-size: 14px;
            }

                .login-container input:focus {
                    outline: none;
                    border-color: #b48a00;
                    box-shadow: 0 0 5px #b48a00;
                }

            .login-container button {
                width: 100%;
                padding: 12px;
                margin-top: 15px;
                border: none;
                border-radius: 8px;
                background-color: #d4a017;
                color: white;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: background 0.3s;
            }

                .login-container button:hover {
                    background-color: #b48a00;
                }

        .extra-links {
            margin-top: 15px;
            font-size: 13px;
        }

            .extra-links a {
                color: #5a4634;
                text-decoration: none;
            }

                .extra-links a:hover {
                    text-decoration: underline;
                }

        .error-message {
            color: red;
            font-size: 14px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h1>Bienvenidos</h1>
        <h2>LibraPlus</h2>

        <!-- Mensaje de error -->
        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <!-- Formulario que envía datos al controlador -->
        <form asp-action="Index" asp-controller="LogIn" method="post">
            <input type="text" name="email" placeholder="Usuario" required />
            <input type="password" name="password" placeholder="Contraseña" required />
            <button type="submit">Ingresar</button>
        </form>

        <div class="extra-links">
            <p><a href="#">¿Olvidaste tu contraseña?</a></p>
            <p><a href="#">Registrarse</a></p>
        </div>
    </div>
</body>
</html>


