@{
    ViewData["Title"] = "LibraPlus - Home";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        /* ======== Estilos globales ======== */
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fdf6e3; /* fondo pergamino claro */
            color: #5a4634;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ======== Encabezado ======== */
        header {
            background: #d4a017; /* dorado */
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 30px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: bold;
        }

            .logo img {
                height: 40px;
            }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            margin: 0;
            padding: 0;
        }

            nav ul li a {
                color: white;
                font-weight: bold;
                padding: 8px 12px;
                border-radius: 6px;
                transition: background 0.3s;
            }

                nav ul li a:hover {
                    background: rgba(255, 255, 255, 0.2);
                }

        .logout-btn {
            background: #8b6b3f;
            color: white;
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

            .logout-btn:hover {
                background: #704d25;
            }

        /* ======== Sección de bienvenida ======== */
        .hero {
            text-align: center;
            padding: 60px 20px;
            background: url("https://i.ibb.co/2dNN9bt/library-bg.jpg") no-repeat center/cover;
            color: white;
            position: relative;
        }

            .hero::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
            }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .hero h1 {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 18px;
        }

        /* ======== Secciones principales ======== */
        .section {
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

            .section h2 {
                text-align: center;
                color: #8b6b3f;
                margin-bottom: 20px;
            }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .card {
            background: rgba(255, 248, 220, 0.9);
            border: 1px solid #e6d8a2;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            transition: transform 0.3s;
        }

            .card:hover {
                transform: translateY(-5px);
            }

            .card img {
                max-width: 100%;
                height: 150px;
                border-radius: 8px;
                object-fit: cover;
            }

            .card h3 {
                margin: 10px 0 5px;
                color: #5a4634;
            }

        /* ======== Footer ======== */
        footer {
            text-align: center;
            background: #d4a017;
            color: white;
            padding: 15px 10px;
            margin-top: 40px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <!-- Encabezado -->
    <header>
        <div class="logo">
            <img src="https://i.ibb.co/CPkRbNz/book-logo.png" alt="Logo">
            LibraPlus
        </div>
        <nav>
            <ul>
                <li><a href="@Url.Action("Index", "Libros")">Libros</a></li>
                <li><a href="@Url.Action("Index", "Prestamos")">Préstamos</a></li>
                <li><a href="@Url.Action("Index", "Resenas")">Reseñas</a></li>
                <li><a href="@Url.Action("Index", "Recomendaciones")">Recomendaciones</a></li>
                <li><a href="@Url.Action("Index", "Usuarios")">Usuarios</a></li>
                <li><a href="@Url.Action("Index", "Compras")">Compras</a></li> <!-- Nuevo botón de Compras -->
            </ul>
        </nav>
        <a class="logout-btn" href="@Url.Action("CerrarSesion", "LogIn")">Cerrar sesión</a>
    </header>

    <!-- Sección de bienvenida -->
    <section class="hero">
        <div class="hero-content">
            <h1>Bienvenido a LibraPlus</h1>
            <p>Tu biblioteca digital y física en un solo lugar.</p>
        </div>
    </section>

    <!-- Sección de libros destacados -->
    <section class="section">
        <h2>Libros Destacados</h2>
        <div class="grid">
            <div class="card">
                <img src="https://www.planetadelibros.com.ar/usuaris/libros/fotos/137/original/portada_el-hobbit-bolsillo_j-r-r-tolkien_201906251756.jpg" alt="Libro 1">
                <h3>El Hobbit</h3>
                <p>J.R.R. Tolkien</p>
            </div>
            <div class="card">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTATBv5W-GlLIHDs9-5tFC0SQ4ev3mPUIa_dp78fFzpQRJBS6Zrc2bHe19cHaDMCIT6XRI&usqp=CAU" alt="Libro 2">
                <h3>Cien años de soledad</h3>
                <p>Gabriel García Márquez</p>
            </div>
            <div class="card">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRjMGsgcMIzSRSoUriH4qZQ0_QEWDWjhntR0w&s" alt="Libro 3">
                <h3>The Dark Knigh Returns</h3>
                <p>Frank Miller</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2025 LibraPlus. Todos los derechos reservados.</p>
    </footer>
</body>
</html>


