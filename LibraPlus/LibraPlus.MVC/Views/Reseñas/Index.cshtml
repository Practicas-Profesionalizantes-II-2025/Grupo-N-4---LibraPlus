@{
    ViewData["Title"] = "Administración de Reseñas - LibraPlus";
    Layout = "_Layout";
}

<div class="container-beige">
    <h2 class="titulo">Reseñas</h2>
    <button class="btn-agregar" onclick="openModal()">+ Agregar Reseña</button>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Comentario</th>
                    <th>Puntuación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="reseñasTableBody"></tbody>
        </table>
    </div>
</div>

<!-- -------- MODAL -------- -->
<div class="modal" id="reseñaModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal()">×</button>
        <h3 id="modalTitle">Agregar Reseña</h3>
        <form id="reseñaForm">
            @Html.AntiForgeryToken()

            <select id="usuario" name="usuario" required>
                <option value="">Seleccione un Usuario</option>
            </select>

            <select id="libro" name="libro" required>
                <option value="">Seleccione un Libro</option>
            </select>

            <textarea id="comentario" name="comentario" placeholder="Comentario" rows="3"></textarea>
            <input type="number" id="puntuacion" name="puntuacion" placeholder="Puntuación (1-5)" min="1" max="5" required />

            <div class="modal-actions">
                <button type="submit" class="save">Guardar</button>
                <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('reseñaModal');
        const reseñaForm = document.getElementById('reseñaForm');
        const tableBody = document.getElementById('reseñasTableBody');
        const selectUsuario = document.getElementById('usuario');
        const selectLibro = document.getElementById('libro');

        let allReseñas = [];
        let allUsuarios = [];
        let allLibros = [];

        // ====== MODAL ======
        function openModal() {
            modal.style.display = 'flex';
            reseñaForm.reset();
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        window.onclick = e => { if (e.target === modal) closeModal(); }

        // ====== TABLA ======
        function renderTable() {
            tableBody.innerHTML = '';
            allReseñas.forEach(r => {
                const usuario = allUsuarios.find(u => u.usuarioId === r.usuarioID)?.nombre ?? 'Desconocido';
                const libro = allLibros.find(l => l.libroID === r.libroID)?.titulo ?? 'Desconocido';

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libro}</td>
                    <td>${r.comentario ?? ''}</td>
                    <td>${r.puntuacion} ⭐</td>
                    <td>
                        <button class="btn-return" onclick="deleteReseña(${r.reseñaID})">Eliminar</button>
                    </td>
                `;
                tableBody.appendChild(row);
            });
        }

        // ====== CARGAR DATOS ======
        async function loadAllData() {
            try {
                // 🔹 Usuarios
                allUsuarios = await (await fetch('/Usuarios/GetUsuarios')).json();
                selectUsuario.innerHTML = '<option value="">Seleccione un Usuario</option>';
                allUsuarios.forEach(u => {
                    const option = document.createElement('option');
                    option.value = u.usuarioId;
                    option.textContent = u.nombre;
                    selectUsuario.appendChild(option);
                });

                // 🔹 Libros
                allLibros = await (await fetch('/Libros/GetLibros')).json();
                selectLibro.innerHTML = '<option value="">Seleccione un Libro</option>';
                allLibros.forEach(l => {
                    const option = document.createElement('option');
                    option.value = l.libroID;
                    option.textContent = l.titulo;
                    selectLibro.appendChild(option);
                });

                // 🔹 Reseñas
                const reseñasResp = await fetch('/Reseñas/Lista');
                if (!reseñasResp.ok) throw new Error("No se pudieron cargar las reseñas");
                allReseñas = await reseñasResp.json();
                renderTable();
            } catch (err) {
                console.error('❌ Error cargando datos:', err);
                showToast("❌ Error al cargar datos: " + err.message, "error");
            }
        }

        // ====== CREAR ======
        reseñaForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const reseñaData = {
                UsuarioID: parseInt(selectUsuario.value),
                LibroID: parseInt(selectLibro.value),
                Comentario: document.getElementById('comentario').value,
                Puntuacion: parseInt(document.getElementById('puntuacion').value)
            };

            const token = document.getElementsByName('__RequestVerificationToken')[0].value;

            try {
                const response = await fetch('/Reseñas/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(reseñaData)
                });

                const text = await response.text();
                const data = text ? JSON.parse(text) : null;

                if (!response.ok) throw new Error(data?.mensaje || "Error al crear la reseña");

                showToast(data?.mensaje || "✅ Reseña agregada correctamente", "success");
                await loadAllData();
                closeModal();
            } catch (err) {
                console.error('❌ Error al crear reseña:', err);
                showToast("❌ " + err.message, "error");
            }
        });

        // ====== ELIMINAR ======
                async function deleteReseña(id) {
            // 🟡 Muestra un pequeño cuadro de confirmación personalizado
            const confirmBox = document.createElement("div");
            confirmBox.className = "modal-confirm";
            confirmBox.innerHTML = `
                <div class="modal-content-confirm">
                    <h3>¿Eliminar reseña?</h3>
                    <p>Esta acción no se puede deshacer.</p>
                    <div class="buttons">
                        <button id="confirmYes" class="btn-confirm">Sí, eliminar</button>
                        <button id="confirmNo" class="btn-cancel">Cancelar</button>
                    </div>
                </div>
            `;
            document.body.appendChild(confirmBox);

            // Animar entrada
            setTimeout(() => confirmBox.classList.add("show"), 100);

            // Esperar respuesta del usuario
            return new Promise((resolve) => {
                document.getElementById("confirmYes").onclick = async () => {
                    confirmBox.classList.remove("show");
                    setTimeout(() => confirmBox.remove(), 300);
                    try {
                        const response = await fetch(`/Reseñas/Delete/${id}`, { method: "DELETE" });
                        if (response.ok) {
                            const text = await response.text();
                            const data = text ? JSON.parse(text) : {};
                            showToast(data.mensaje || "✅ Reseña eliminada correctamente", "success");
                            allReseñas = allReseñas.filter(r => r.reseñaID !== id);
                            renderTable();
                        } else {
                            const errorText = await response.text();
                            showToast("❌ " + (errorText || "No se pudo eliminar la reseña."), "error");
                        }
                    } catch (err) {
                        showToast("❌ Error al eliminar reseña: " + err.message, "error");
                    }
                    resolve(true);
                };

                document.getElementById("confirmNo").onclick = () => {
                    confirmBox.classList.remove("show");
                    setTimeout(() => confirmBox.remove(), 300);
                    resolve(false);
                };
            });
        }


        // ====== TOAST ======
        function showToast(message, type = "success") {
            const toast = document.createElement("div");
            toast.className = "toast " + (type === "error" ? "error" : "");

            const icon = document.createElement("span");
            icon.className = "icon";
            icon.textContent = type === "error" ? "❌" : "✅";

            const text = document.createElement("span");
            text.textContent = message;

            toast.appendChild(icon);
            toast.appendChild(text);
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.add("show"), 100);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ====== INICIALIZACIÓN ======
        loadAllData();
    </script>
}
