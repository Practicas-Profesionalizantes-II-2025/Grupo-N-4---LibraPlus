@using LibraPlus.MVC.Models
@model List<LibrosDTO>

@{
    ViewData["Title"] = "📚 Biblioteca - LibraPlus";
    Layout = "_Layout";
    var isAdmin = User.IsInRole("Admin");
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container-beige">
    <h2 class="titulo">📚 Biblioteca</h2>

    @if (isAdmin)
    {
        <button type="button" class="btn-agregar" id="addBookBtn">
            <i class="fas fa-plus"></i> Agregar Libro
        </button>
    }

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Género</th>
                    <th>Tipo</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Compras</th>
                    <th>Reseñas</th>
                    @* Solo admin ve la columna de acciones *@
                    @if (isAdmin)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody id="bookTableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var libro in Model)
                    {
                        <tr data-id="@libro.LibroID"
                            data-titulo="@libro.Titulo"
                            data-autor="@libro.Autor"
                            data-genero="@libro.Genero"
                            data-tipo="@libro.Tipo"
                            data-precio="@libro.Precio"
                            data-stock="@libro.Stock">
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>@libro.Genero</td>
                            <td>@libro.Tipo</td>
                            <td>$@libro.Precio</td>
                            <td>@libro.Stock</td>
                            <td>@libro.CantidadCompras</td>
                            <td>@libro.CantidadReseñas</td>

                            @* Solo admin ve los botones *@
                            @if (isAdmin)
                            {
                                <td class="action-buttons">
                                    <button class="btn btn-edit" data-action="edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-delete" data-action="delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isAdmin ? "9" : "8")" style="text-align:center;">No hay libros disponibles</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 🟣 MODAL PRINCIPAL (Agregar/Editar) -->
<div class="modal" id="bookModal">
    <div class="modal-content">
        <button type="button" class="close-btn" id="closeModalBtn">&times;</button>
        <h3 id="modalTitle">Agregar Libro</h3>

        <form id="bookForm">
            <input type="hidden" id="libroId" />
            <input type="text" id="titulo" placeholder="Título" required />
            <input type="text" id="autor" placeholder="Autor" required />
            <input type="text" id="genero" placeholder="Género" required />
            <select id="tipo" required>
                <option value="">Tipo</option>
                <option value="Digital">Digital</option>
                <option value="Físico">Físico</option>
            </select>
            <input type="text" id="precio" placeholder="Precio (usar . para decimales)" required />
            <input type="number" id="stock" placeholder="Stock" required min="0" step="1" />

            <div class="modal-actions">
                <button type="submit" class="save">💾 Guardar</button>
                <button type="button" class="cancel" id="cancelBtn">Cancelar</button>
            </div>
        </form>
    </div>
</div>

<!-- 🟣 MODAL DE CONFIRMACIÓN -->
<div id="confirmModal" class="confirm-modal">
    <div class="confirm-box">
        <h3 id="confirmTitle">¿Estás seguro?</h3>
        <p id="confirmMessage">Esta acción no se puede deshacer.</p>
        <div class="confirm-buttons">
            <button id="confirmCancel" class="cancel-btn">Cancelar</button>
            <button id="confirmOk" class="ok-btn">Confirmar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('bookModal');
        const form = document.getElementById('bookForm');
        const tableBody = document.getElementById('bookTableBody');
        const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
        const modalTitle = document.getElementById('modalTitle');

        // --- Abrir modal agregar ---
        document.getElementById('addBookBtn').addEventListener('click', () => {
            modal.style.display = 'flex';
            modalTitle.textContent = "Agregar Libro";
            form.dataset.mode = "add";
            form.reset();
            document.getElementById('libroId').value = "";
        });

        // --- Cerrar modal ---
        document.getElementById('closeModalBtn').onclick = () => modal.style.display = 'none';
        document.getElementById('cancelBtn').onclick = () => modal.style.display = 'none';
        window.onclick = e => { if (e.target === modal) modal.style.display = 'none'; };

        // --- Editar / Eliminar ---
        tableBody.addEventListener('click', e => {
            const btn = e.target.closest("button");
            if (!btn) return;
            const row = btn.closest("tr");

            // ✏️ Editar
            if (btn.dataset.action === "edit") {
                modal.style.display = 'flex';
                modalTitle.textContent = "Editar Libro";
                form.dataset.mode = "edit";
                document.getElementById('libroId').value = row.dataset.id;
                document.getElementById('titulo').value = row.dataset.titulo;
                document.getElementById('autor').value = row.dataset.autor;
                document.getElementById('genero').value = row.dataset.genero;
                document.getElementById('tipo').value = row.dataset.tipo;
                document.getElementById('precio').value = row.dataset.precio;
                document.getElementById('stock').value = row.dataset.stock;
            }

            // 🗑️ Eliminar
            if (btn.dataset.action === "delete") {
                const id = row.dataset.id;
                showConfirm("🗑️ ¿Seguro que querés eliminar este libro?", async () => {
                    try {
                        const response = await fetch(`/Libros/Delete/${id}`, { method: "POST" });
                        const data = await response.json();

                        if (data.success) {
                            showToast(data.mensaje || "✅ Libro eliminado correctamente", "success");
                            row.remove();
                        } else if (data.dependencias) {
                            showConfirm("⚠️ Este libro tiene préstamos o reseñas asociadas. ¿Eliminarlo igual?", async () => {
                                const forceResp = await fetch(`/Libros/ForceDelete/${id}`, { method: "POST" });
                                const result = await forceResp.json();
                                showToast(result.mensaje || "✅ Libro y dependencias eliminados", "success");
                                row.remove();
                            });
                        } else {
                            showToast(data.mensaje || "❌ No se pudo eliminar el libro", "error");
                        }
                    } catch (err) {
                        showToast("❌ Error al eliminar libro: " + err.message, "error");
                    }
                });
            }
        });

        // --- Guardar libro ---
        form.addEventListener("submit", async e => {
            e.preventDefault();

            const precioValue = document.getElementById('precio').value.trim().replace(",", ".");
            const libro = {
                LibroID: parseInt(document.getElementById('libroId').value || '0'),
                Titulo: document.getElementById('titulo').value,
                Autor: document.getElementById('autor').value,
                Genero: document.getElementById('genero').value,
                Tipo: document.getElementById('tipo').value,
                Precio: parseFloat(precioValue),
                Stock: parseInt(document.getElementById('stock').value)
            };

            const url = form.dataset.mode === "add" ? "/Libros/Create" : `/Libros/Edit/${libro.LibroID}`;

            try {
                const res = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify(libro)
                });

                if (!res.ok) throw new Error(await res.text());
                showToast("✅ Libro guardado correctamente");
                setTimeout(() => location.reload(), 1000);
            } catch (err) {
                showToast("❌ Error: " + err.message, "error");
            }
        });

        // ===== MODAL DE CONFIRMACIÓN =====
        function showConfirm(message, onConfirm) {
            const modal = document.getElementById("confirmModal");
            const msg = document.getElementById("confirmMessage");
            const okBtn = document.getElementById("confirmOk");
            const cancelBtn = document.getElementById("confirmCancel");

            msg.textContent = message;
            modal.style.display = "flex";

            const close = () => modal.style.display = "none";

            okBtn.onclick = () => { close(); onConfirm(); };
            cancelBtn.onclick = close;
            window.onclick = (e) => { if (e.target === modal) close(); };
        }

        // --- TOAST ---
        function showToast(msg, type = 'success') {
            const toast = document.createElement("div");
            toast.className = "toast " + (type === "error" ? "error" : "");
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.classList.add("show"), 100);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
}
