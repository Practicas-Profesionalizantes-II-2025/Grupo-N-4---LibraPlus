@{
    ViewData["Title"] = "Administración de Libros";
}
@using LibraPlus.MVC.Models
@model List<LibrosDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Libros - LibraPlus</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fdf6e3;
            color: #5a4634;
        }

        header {
            background: #d4a017;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

            header h1 {
                font-size: 22px;
                margin: 0;
            }

        .btn-volver {
            background: #8b6b3f;
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            transition: background 0.3s;
        }

            .btn-volver:hover {
                background: #704d25;
            }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            background: rgba(255, 248, 220, 0.95);
            border: 2px solid #e6d8a2;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        h2 {
            text-align: center;
            color: #8b6b3f;
            margin-bottom: 20px;
        }

        .add-book {
            display: block;
            margin: 0 auto 20px;
            background: #8b6b3f;
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            width: fit-content;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: bold;
            border: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .add-book:hover {
                background: #704d25;
            }

        .icon-plus {
            font-size: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

            table th, table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #e6d8a2;
            }

            table th {
                background: #d4a017;
                color: white;
            }

            table tr:hover {
                background: rgba(212, 160, 23, 0.1);
            }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s, transform 0.2s;
        }

        .btn-edit {
            background: #d4a017;
            color: white;
        }

            .btn-edit:hover {
                background: #b48a00;
            }

        .btn-delete {
            background: #8b0000;
            color: white;
        }

            .btn-delete:hover {
                background: #5a0000;
            }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: #fff8dc;
            padding: 20px;
            border-radius: 10px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            position: relative;
            box-sizing: border-box;
            margin: 0 auto;
        }

            .modal-content h3 {
                text-align: center;
                color: #8b6b3f;
                margin-bottom: 15px;
            }

            .modal-content input, .modal-content select {
                width: 100%;
                box-sizing: border-box;
                padding: 10px;
                margin-bottom: 15px;
                border: 1px solid #c9b97e;
                border-radius: 8px;
                font-size: 14px;
            }

                .modal-content input:focus, .modal-content select:focus {
                    outline: none;
                    border-color: #b48a00;
                    box-shadow: 0 0 5px #b48a00;
                }

            .modal-content .modal-actions {
                display: flex;
                justify-content: space-between;
            }

            .modal-content button {
                padding: 10px 15px;
                border: none;
                border-radius: 8px;
                font-weight: bold;
                cursor: pointer;
            }

            .modal-content .save {
                background: #d4a017;
                color: white;
            }

                .modal-content .save:hover {
                    background: #b48a00;
                }

            .modal-content .cancel {
                background: #8b0000;
                color: white;
            }

                .modal-content .cancel:hover {
                    background: #5a0000;
                }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #5a4634;
        }

            .close-btn:hover {
                color: #8b0000;
            }
    </style>
</head>
<body>
    <header>
        <h1>LibraPlus - Administración de Libros</h1>
        <a class="btn-volver" href="@Url.Action("Index", "Home")">Volver</a>
    </header>

    <div class="container">
        <h2>Libros Disponibles</h2>
        <button id="addBookBtn" class="add-book">
            <span class="icon-plus">+</span> Agregar Libro
        </button>

        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Género</th>
                    <th>Tipo</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="bookTableBody">
                @foreach (var libro in Model)
                {
                    <tr data-id="@libro.LibroID"
                        data-titulo="@libro.Titulo"
                        data-autor="@libro.Autor"
                        data-genero="@libro.Genero"
                        data-tipo="@libro.Tipo"
                        data-precio="@libro.Precio"
                        data-stock="@libro.Stock">
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.Genero</td>
                        <td>@libro.Tipo</td>
                        <td>@libro.Precio</td>
                        <td>@libro.Stock</td>
                        <td class="action-buttons">
                            <button class="btn btn-edit" data-action="edit">Editar</button>
                            <button class="btn btn-delete" data-action="delete">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal" id="bookModal">
        <div class="modal-content">
            <button class="close-btn" id="closeModalBtn">&times;</button>
            <h3 id="modalTitle">Agregar Libro</h3>
            <form id="bookForm">
                <input type="hidden" id="libroId" />
                <input type="text" id="titulo" placeholder="Título" required />
                <input type="text" id="autor" placeholder="Autor" required />
                <input type="text" id="genero" placeholder="Género" required />
                <select id="tipo" required>
                    <option value="">Tipo</option>
                    <option value="Digital">Digital</option>
                    <option value="Físico">Físico</option>
                </select>
                <input type="number" id="precio" placeholder="Precio" required min="0.01" step="0.01" />
                <input type="number" id="stock" placeholder="Stock" required min="0" step="1" />
                @Html.AntiForgeryToken()
                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" id="cancelBtn">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('bookModal');
            const modalTitle = document.getElementById('modalTitle');
            const form = document.getElementById('bookForm');
            const inputId = document.getElementById('libroId');
            const inputTitulo = document.getElementById('titulo');
            const inputAutor = document.getElementById('autor');
            const inputGenero = document.getElementById('genero');
            const inputTipo = document.getElementById('tipo');
            const inputPrecio = document.getElementById('precio');
            const inputStock = document.getElementById('stock');
            const tableBody = document.getElementById('bookTableBody');

            // Event Listeners
            document.getElementById('addBookBtn').addEventListener('click', () => openModal('add'));
            document.getElementById('closeModalBtn').addEventListener('click', closeModal);
            document.getElementById('cancelBtn').addEventListener('click', closeModal);
            window.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });

            tableBody.addEventListener('click', (e) => {
                const button = e.target.closest('button');
                if (!button) return;

                const row = button.closest('tr');
                const id = parseInt(row.dataset.id);

                if (button.dataset.action === 'edit') {
                    openModal('edit', row);
                } else if (button.dataset.action === 'delete') {
                    deleteBook(id, button);
                }
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const libro = {
                    LibroID: parseInt(inputId.value || '0'),
                    Titulo: inputTitulo.value.trim(),
                    Autor: inputAutor.value.trim(),
                    Genero: inputGenero.value.trim(),
                    Tipo: inputTipo.value,
                    Precio: parseFloat(inputPrecio.value),
                    Stock: parseInt(inputStock.value)
                };

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                let url = form.dataset.mode === 'add' ? '/Libros/Create' : `/Libros/Edit/${libro.LibroID}`;
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(libro)
                    });

                    if (!response.ok) throw new Error('Error al guardar el libro.');

                    const returned = await response.json().catch(() => libro);

                    if (form.dataset.mode === 'add') {
                        const newRow = createBookRow(returned);
                        tableBody.appendChild(newRow);
                    } else {
                        updateBookRow(returned);
                    }

                    closeModal();
                } catch (err) {
                    console.error(err);
                    alert(`Error al guardar el libro. Revisa la consola para más detalles.`);
                }
            });

            // Helper functions
            function openModal(mode, row = null) {
                if (mode === 'add') {
                    modalTitle.textContent = 'Agregar Libro';
                    form.dataset.mode = 'add';
                    form.reset();
                } else if (mode === 'edit' && row) {
                    modalTitle.textContent = 'Editar Libro';
                    form.dataset.mode = 'edit';
                    inputId.value = row.dataset.id;
                    inputTitulo.value = row.dataset.titulo;
                    inputAutor.value = row.dataset.autor;
                    inputGenero.value = row.dataset.genero;
                    inputTipo.value = row.dataset.tipo;
                    inputPrecio.value = row.dataset.precio;
                    inputStock.value = row.dataset.stock;
                }
                modal.style.display = 'flex';
            }

            function closeModal() {
                modal.style.display = 'none';
            }

            function createBookRow(libro) {
                const tr = document.createElement('tr');
                tr.dataset.id = libro.LibroID;
                tr.dataset.titulo = libro.Titulo;
                tr.dataset.autor = libro.Autor;
                tr.dataset.genero = libro.Genero;
                tr.dataset.tipo = libro.Tipo;
                tr.dataset.precio = libro.Precio;
                tr.dataset.stock = libro.Stock;
                tr.innerHTML = `
                    <td>${libro.Titulo}</td>
                    <td>${libro.Autor}</td>
                    <td>${libro.Genero}</td>
                    <td>${libro.Tipo}</td>
                    <td>${libro.Precio}</td>
                    <td>${libro.Stock}</td>
                    <td class="action-buttons">
                        <button class="btn btn-edit" data-action="edit">Editar</button>
                        <button class="btn btn-delete" data-action="delete">Eliminar</button>
                    </td>`;
                return tr;
            }

            function updateBookRow(libro) {
                const row = document.querySelector(`tr[data-id="${libro.LibroID}"]`);
                if (row) {
                    row.dataset.titulo = libro.Titulo;
                    row.dataset.autor = libro.Autor;
                    row.dataset.genero = libro.Genero;
                    row.dataset.tipo = libro.Tipo;
                    row.dataset.precio = libro.Precio;
                    row.dataset.stock = libro.Stock;
                    row.cells[0].textContent = libro.Titulo;
                    row.cells[1].textContent = libro.Autor;
                    row.cells[2].textContent = libro.Genero;
                    row.cells[3].textContent = libro.Tipo;
                    row.cells[4].textContent = libro.Precio;
                    row.cells[5].textContent = libro.Stock;
                }
            }

            async function deleteBook(id, button) {
                if (!confirm('¿Seguro que deseas eliminar este libro?')) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const url = `/Libros/Delete/${id}`;

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (!response.ok) {
                        const text = await response.text();
                        throw new Error(text || 'Error al eliminar el libro');
                    }

                    const row = button.closest('tr');
                    if (row) row.remove();
                } catch (err) {
                    console.error(err);
                    alert(`Error al eliminar el libro. Revisa la consola.`);
                }
            }
        });
    </script>
</body>
</html>