@using LibraPlus.MVC.Models
@model List<ComprasDTO>
@{
    ViewData["Title"] = "Historial de Compras";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Compras - LibraPlus</title>
    <style>
        /* ----------- ESTILOS GENERALES ----------- */
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fdf6e3;
            color: #5a4634;
        }

        header {
            background: #d4a017;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

            header h1 {
                font-size: 22px;
                margin: 0;
            }

        /* Botón volver */
        .btn-back {
            background: white;
            color: #d4a017;
            border: 2px solid white;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

            .btn-back:hover {
                background: #f6e8c6;
                color: #8b6b3f;
                border-color: #f6e8c6;
            }

        /* ----------- CONTENEDOR PRINCIPAL ----------- */
        .container {
            max-width: 1000px;
            margin: 30px auto;
            background: rgba(255, 248, 220, 0.95);
            border: 2px solid #e6d8a2;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        h2 {
            text-align: center;
            color: #8b6b3f;
            margin-bottom: 20px;
        }

        /* Botón registrar */
        .add-purchase {
            display: block;
            margin: 0 auto 20px;
            background: #8b6b3f;
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            width: fit-content;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: bold;
        }

            .add-purchase:hover {
                background: #704d25;
            }

        /* ----------- TABLA ----------- */
        .table-container {
            max-height: 400px; /* Scroll interno */
            overflow-y: auto;
            border: 1px solid #e6d8a2;
            border-radius: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
        }

            table th, table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #e6d8a2;
            }

            table th {
                background: #d4a017;
                color: white;
                position: sticky;
                top: 0;
                z-index: 2;
            }

            table tr:hover {
                background: rgba(212, 160, 23, 0.08);
            }

        /* ----------- MODAL ----------- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: #fff8dc;
            padding: 20px;
            border-radius: 10px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            position: relative;
            box-sizing: border-box;
            margin: 0 auto;
        }

            .modal-content h3 {
                text-align: center;
                color: #8b6b3f;
                margin-bottom: 15px;
            }

            .modal-content input,
            .modal-content select {
                width: 100%;
                box-sizing: border-box;
                padding: 10px;
                margin-bottom: 15px;
                border: 1px solid #c9b97e;
                border-radius: 8px;
                font-size: 14px;
            }

                .modal-content input:focus,
                .modal-content select:focus {
                    outline: none;
                    border-color: #b48a00;
                    box-shadow: 0 0 5px #b48a00;
                }

            .modal-content .modal-actions {
                display: flex;
                justify-content: space-between;
            }

            .modal-content button {
                padding: 10px 15px;
                border: none;
                border-radius: 8px;
                font-weight: bold;
                cursor: pointer;
            }

            .modal-content .save {
                background: #d4a017;
                color: white;
            }

                .modal-content .save:hover {
                    background: #b48a00;
                }

            .modal-content .cancel {
                background: #8b0000;
                color: white;
            }

                .modal-content .cancel:hover {
                    background: #5a0000;
                }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #5a4634;
        }

            .close-btn:hover {
                color: #8b0000;
            }
    </style>
</head>
<body>
    <header>
        <h1>LibraPlus - Administración de Compras</h1>
        <button class="btn-back" onclick="location.href='@Url.Action("Index", "Home")'">Volver</button>
    </header>

    <div class="container">
        <h2>Historial de Compras</h2>
        <button class="add-purchase" onclick="openModal()">+ Registrar Compra</button>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Libro</th>
                        <th>Fecha</th>
                        <th>Precio</th>
                        <th>Tipo</th>
                        <th>URL Descarga</th>
                    </tr>
                </thead>
                <tbody id="purchaseTableBody"></tbody>
            </table>
        </div>
    </div>

    <!-- ----------- MODAL ----------- -->
    <div class="modal" id="purchaseModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">×</button>
            <h3 id="modalTitle">Registrar Compra</h3>
            <form id="purchaseForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCompraID">

                <select id="usuario" name="usuario" required>
                    <option value="">Seleccione un Usuario</option>
                </select>

                <select id="libro" name="libro" required>
                    <option value="">Seleccione un Libro</option>
                </select>

                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('purchaseModal');
        const purchaseForm = document.getElementById('purchaseForm');
        const tableBody = document.getElementById('purchaseTableBody');
        const modalTitle = document.getElementById('modalTitle');
        const selectUsuario = document.getElementById('usuario');
        const selectLibro = document.getElementById('libro');

        let allCompras = [];
        let allUsuarios = [];
        let allLibros = [];

        function openModal() {
            modal.style.display = 'flex';
            modalTitle.textContent = 'Registrar Compra';
            purchaseForm.reset();
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        window.onclick = e => {
            if (e.target === modal) closeModal();
        }

        function renderTable() {
            tableBody.innerHTML = '';
            allCompras.forEach(c => {
                const usuario = allUsuarios.find(u => u.UsuarioId === c.usuarioID)?.Nombre ?? 'Desconocido';
                const libro = allLibros.find(l => l.libroID === c.libroID);
                const libroTitulo = libro?.titulo ?? 'Desconocido';
                const tipo = libro?.tipo ?? 'Desconocido';
                const fecha = new Date(c.fecha).toLocaleDateString();

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${usuario}</td>
                    <td>${libroTitulo}</td>
                    <td>${fecha}</td>
                    <td>$${c.precio.toFixed(2)}</td>
                    <td>${tipo}</td>
                    <td>${c.descargaURL ?? 'N/A'}</td>
                `;
                tableBody.appendChild(row);
            });
        }

        async function loadAllData() {
            try {
                // Cargar usuarios
                allUsuarios = await (await fetch('/Usuarios/GetUsuarios')).json();
                allUsuarios.forEach(u => {
                    const option = document.createElement('option');
                    option.value = u.UsuarioId;
                    option.textContent = u.Nombre;
                    selectUsuario.appendChild(option);
                });

                // Cargar libros
                allLibros = await (await fetch('/Libros/GetLibros')).json();
                allLibros.forEach(l => {
                    const option = document.createElement('option');
                    option.value = l.libroID;
                    option.textContent = `${l.titulo} - ${l.autor}`;
                    selectLibro.appendChild(option);
                });

                // Cargar compras
                allCompras = await (await fetch('/Compras/GetCompras')).json();
                renderTable();
            } catch (err) {
                console.error('Error cargando datos:', err);
                alert('Hubo un error al cargar los datos. Por favor, intente de nuevo.');
            }
        }

        purchaseForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const compraData = {
                UsuarioID: parseInt(selectUsuario.value),
                LibroID: parseInt(selectLibro.value)
            };

            try {
                const response = await fetch('/Compras/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0].value
                    },
                    body: JSON.stringify(compraData)
                });

                if (!response.ok) throw new Error(await response.text());

                const newCompra = await response.json();
                allCompras.push(newCompra);
                renderTable();
                closeModal();
            } catch (err) {
                console.error('Error al guardar la compra:', err);
                alert('Error al guardar la compra: ' + err.message);
            }
        });

        loadAllData();
    </script>
</body>
</html>
