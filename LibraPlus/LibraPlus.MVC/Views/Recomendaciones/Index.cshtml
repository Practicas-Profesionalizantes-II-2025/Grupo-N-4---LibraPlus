@{
    ViewData["Title"] = "Administración de Recomendaciones - LibraPlus";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fdf6e3;
            color: #5a4634;
        }

        header {
            background: #d4a017;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

            header h1 {
                font-size: 22px;
            }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            background: rgba(255, 248, 220, 0.95);
            border: 2px solid #e6d8a2;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        h2 {
            text-align: center;
            color: #8b6b3f;
            margin-bottom: 20px;
        }

        .add-recommendation {
            display: block;
            margin: 0 auto 20px;
            background: #8b6b3f;
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            width: fit-content;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: bold;
        }

            .add-recommendation:hover {
                background: #704d25;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

            table th, table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #e6d8a2;
            }

            table th {
                background: #d4a017;
                color: white;
            }

            table tr:hover {
                background: rgba(212, 160, 23, 0.1);
            }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s;
        }

        .btn-edit {
            background: #d4a017;
            color: white;
        }

            .btn-edit:hover {
                background: #b48a00;
            }

        .btn-delete {
            background: #8b0000;
            color: white;
        }

            .btn-delete:hover {
                background: #5a0000;
            }

        /* --- MODAL --- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: #fff8dc;
            padding: 20px;
            border-radius: 10px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            position: relative;
            box-sizing: border-box;
            margin: 0 auto;
        }

            .modal-content h3 {
                text-align: center;
                color: #8b6b3f;
                margin-bottom: 15px;
            }

            .modal-content input, .modal-content select {
                width: 100%;
                box-sizing: border-box;
                padding: 10px;
                margin-bottom: 15px;
                border: 1px solid #c9b97e;
                border-radius: 8px;
                font-size: 14px;
            }

                .modal-content input:focus, .modal-content select:focus {
                    outline: none;
                    border-color: #b48a00;
                    box-shadow: 0 0 5px #b48a00;
                }

            .modal-content .modal-actions {
                display: flex;
                justify-content: space-between;
            }

            .modal-content button {
                padding: 10px 15px;
                border: none;
                border-radius: 8px;
                font-weight: bold;
                cursor: pointer;
            }

            .modal-content .save {
                background: #d4a017;
                color: white;
            }

                .modal-content .save:hover {
                    background: #b48a00;
                }

            .modal-content .cancel {
                background: #8b0000;
                color: white;
            }

                .modal-content .cancel:hover {
                    background: #5a0000;
                }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #5a4634;
        }

            .close-btn:hover {
                color: #8b0000;
            }
    </style>
</head>
<body>

    <header>
        <h1>LibraPlus - Administración de Recomendaciones</h1>
        <button class="btn-delete">Cerrar sesión</button>
    </header>

    <div class="container">
        <h2>Lista de Recomendaciones</h2>
        <button class="add-recommendation" onclick="openModal()">+ Agregar Recomendación</button>

        <table>
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Fuente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="recommendationTableBody"></tbody>
        </table>
    </div>

    <div class="modal" id="recommendationModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">×</button>
            <h3 id="modalTitle">Agregar Recomendación</h3>
            <form id="recommendationForm">
                <input type="hidden" id="editIndex">
                <select id="usuario" name="usuario" required>
                    <option value="">Seleccione un Usuario</option>
                    <option value="1">Juan Pérez</option>
                    <option value="2">María Gómez</option>
                </select>
                <select id="libro" name="libro" required>
                    <option value="">Seleccione un Libro</option>
                    <option value="1">El Principito</option>
                    <option value="2">Cien Años de Soledad</option>
                </select>
                <input type="text" id="fuente" name="fuente" placeholder="Fuente de recomendación" required>
                <div class="modal-actions">
                    <button type="submit" class="save">Guardar</button>
                    <button type="button" class="cancel" onclick="closeModal()">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('recommendationModal');
        const recommendationForm = document.getElementById('recommendationForm');
        const tableBody = document.getElementById('recommendationTableBody');
        const modalTitle = document.getElementById('modalTitle');

        function openModal(isEdit=false,index=null){
          modal.style.display='flex';
          modalTitle.textContent = isEdit ? 'Editar Recomendación' : 'Agregar Recomendación';
          if(!isEdit){ recommendationForm.reset(); document.getElementById('editIndex').value=''; }
          else { document.getElementById('editIndex').value=index; }
        }

        function closeModal(){ modal.style.display='none'; }
        window.onclick = e => { if(e.target===modal) closeModal(); }

        recommendationForm.addEventListener('submit', function(e){
          e.preventDefault();
          const usuario = document.getElementById('usuario').selectedOptions[0].text;
          const libro = document.getElementById('libro').selectedOptions[0].text;
          const fuente = document.getElementById('fuente').value;
          const editIndex = document.getElementById('editIndex').value;

          if(editIndex===''){
            const row = document.createElement('tr');
            row.innerHTML = `<td>${usuario}</td><td>${libro}</td><td>${fuente}</td>
              <td>
                <button class="btn btn-edit" onclick="editRow(this)">Editar</button>
                <button class="btn btn-delete" onclick="deleteRow(this)">Eliminar</button>
              </td>`;
            tableBody.appendChild(row);
          } else {
            const row = tableBody.children[editIndex];
            row.cells[0].textContent=usuario;
            row.cells[1].textContent=libro;
            row.cells[2].textContent=fuente;
          }
          closeModal();
          recommendationForm.reset();
        });

        function editRow(button){
          const row = button.parentElement.parentElement;
          const index = Array.from(tableBody.children).indexOf(row);
          document.getElementById('usuario').value = row.cells[0].textContent==='Juan Pérez'?'1':'2';
          document.getElementById('libro').value = row.cells[1].textContent==='El Principito'?'1':'2';
          document.getElementById('fuente').value = row.cells[2].textContent;
          openModal(true,index);
        }

        function deleteRow(button){
          if(confirm('¿Seguro que desea eliminar esta recomendación?')){
            const row = button.parentElement.parentElement;
            tableBody.removeChild(row);
          }
        }
    </script>

</body>
</html>

