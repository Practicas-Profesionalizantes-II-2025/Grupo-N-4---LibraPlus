@using LibraPlus.MVC.Models
@model List<LibrosDTO>

@{
    ViewData["Title"] = "Biblioteca - LibraPlus";
    Layout = "_Layout";
}

<div class="container">
    <h2 class="titulo">📚 Libros Disponibles</h2>

    <!-- Botón abrir modal -->
    <button type="button" class="btn-agregar" id="addBookBtn">
        <i class="fas fa-plus"></i> Agregar Libro
    </button>

    <!-- Tabla -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Género</th>
                    <th>Tipo</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="bookTableBody">
                @foreach (var libro in Model)
                {
                    <tr data-id="@libro.LibroID"
                        data-titulo="@libro.Titulo"
                        data-autor="@libro.Autor"
                        data-genero="@libro.Genero"
                        data-tipo="@libro.Tipo"
                        data-precio="@libro.Precio"
                        data-stock="@libro.Stock">
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.Genero</td>
                        <td>@libro.Tipo</td>
                        <td>$@libro.Precio</td>
                        <td>@libro.Stock</td>
                        <td class="action-buttons">
                            <button class="btn btn-edit" data-action="edit">
                                <i class="fas fa-edit"></i> Editar
                            </button>
                            <button class="btn btn-delete" data-action="delete">
                                <i class="fas fa-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal" id="bookModal">
    <div class="modal-content">
        <button type="button" class="close-btn" id="closeModalBtn">&times;</button>
        <h3 id="modalTitle">Agregar Libro</h3>
        <form id="bookForm">
            <input type="hidden" id="libroId" />
            <input type="text" id="titulo" placeholder="Título" required />
            <input type="text" id="autor" placeholder="Autor" required />
            <input type="text" id="genero" placeholder="Género" required />
            <select id="tipo" required>
                <option value="">Tipo</option>
                <option value="Digital">Digital</option>
                <option value="Físico">Físico</option>
            </select>
            <input type="number" id="precio" placeholder="Precio" required min="0.01" step="0.01" />
            <input type="number" id="stock" placeholder="Stock" required min="0" step="1" />

            @Html.AntiForgeryToken()

            <div class="modal-actions">
                <button type="submit" class="save">💾 Guardar</button>
                <button type="button" class="cancel" id="cancelBtn">Cancelar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById("bookModal");
        const form = document.getElementById("bookForm");
        const tableBody = document.getElementById("bookTableBody");
        const modalTitle = document.getElementById("modalTitle");

        const openModal = (mode, row = null) => {
            modal.classList.add("show");
            form.dataset.mode = mode;

            if (mode === "add") {
                modalTitle.textContent = "Agregar Libro";
                form.reset();
                document.getElementById("libroId").value = "";
            } else if (mode === "edit" && row) {
                modalTitle.textContent = "Editar Libro";
                document.getElementById("libroId").value = row.dataset.id;
                document.getElementById("titulo").value = row.dataset.titulo;
                document.getElementById("autor").value = row.dataset.autor;
                document.getElementById("genero").value = row.dataset.genero;
                document.getElementById("tipo").value = row.dataset.tipo;
                document.getElementById("precio").value = row.dataset.precio;
                document.getElementById("stock").value = row.dataset.stock;
            }
        };

        const closeModal = () => modal.classList.remove("show");

        // Abrir modal agregar
        document.getElementById("addBookBtn").addEventListener("click", () => openModal("add"));

        // Cerrar modal
        document.getElementById("closeModalBtn").addEventListener("click", closeModal);
        document.getElementById("cancelBtn").addEventListener("click", closeModal);
        modal.addEventListener("click", e => { if (e.target === modal) closeModal(); });

        // Eventos de tabla (editar / eliminar)
        tableBody.addEventListener("click", async e => {
            const btn = e.target.closest("button");
            if (!btn) return;

            const row = btn.closest("tr");

            if (btn.dataset.action === "edit") {
                openModal("edit", row);
            }

            if (btn.dataset.action === "delete") {
                if (!confirm("¿Seguro que deseas eliminar este libro?")) return;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                try {
                    const res = await fetch(`/Libros/Delete/${row.dataset.id}`, {
                        method: "POST",
                        headers: { "RequestVerificationToken": token }
                    });
                    if (!res.ok) throw new Error(await res.text());
                    row.remove();
                } catch (err) {
                    alert("Error eliminando libro: " + err.message);
                }
            }
        });

        // Guardar libro (agregar o editar)
        form.addEventListener("submit", async e => {
            e.preventDefault();
            const libro = {
                LibroID: parseInt(document.getElementById("libroId").value || "0"),
                Titulo: document.getElementById("titulo").value.trim(),
                Autor: document.getElementById("autor").value.trim(),
                Genero: document.getElementById("genero").value.trim(),
                Tipo: document.getElementById("tipo").value,
                Precio: parseFloat(document.getElementById("precio").value),
                Stock: parseInt(document.getElementById("stock").value)
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const url = form.dataset.mode === "add"
                ? "/Libros/Create"
                : `/Libros/Edit/${libro.LibroID}`;

            try {
                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify(libro)
                });

                if (!response.ok) {
                    const msg = await response.text();
                    throw new Error(msg);
                }

                const saved = await response.json();

                if (form.dataset.mode === "add") {
                    // Agregar fila nueva
                    const tr = document.createElement("tr");
                    tr.dataset.id = saved.libroID;
                    tr.dataset.titulo = saved.titulo;
                    tr.dataset.autor = saved.autor;
                    tr.dataset.genero = saved.genero;
                    tr.dataset.tipo = saved.tipo;
                    tr.dataset.precio = saved.precio;
                    tr.dataset.stock = saved.stock;

                    tr.innerHTML = `
                        <td>${saved.titulo}</td>
                        <td>${saved.autor}</td>
                        <td>${saved.genero}</td>
                        <td>${saved.tipo}</td>
                        <td>$${saved.precio}</td>
                        <td>${saved.stock}</td>
                        <td class="action-buttons">
                            <button class="btn btn-edit" data-action="edit"><i class="fas fa-edit"></i> Editar</button>
                            <button class="btn btn-delete" data-action="delete"><i class="fas fa-trash"></i> Eliminar</button>
                        </td>`;
                    tableBody.appendChild(tr);
                } else {
                    // Actualizar fila existente
                    const row = document.querySelector(`tr[data-id="${saved.libroID}"]`);
                    if (row) {
                        row.dataset.titulo = saved.titulo;
                        row.dataset.autor = saved.autor;
                        row.dataset.genero = saved.genero;
                        row.dataset.tipo = saved.tipo;
                        row.dataset.precio = saved.precio;
                        row.dataset.stock = saved.stock;

                        row.cells[0].textContent = saved.titulo;
                        row.cells[1].textContent = saved.autor;
                        row.cells[2].textContent = saved.genero;
                        row.cells[3].textContent = saved.tipo;
                        row.cells[4].textContent = "$" + saved.precio;
                        row.cells[5].textContent = saved.stock;
                    }
                }

                closeModal();
            } catch (err) {
                alert("Error: " + err.message);
            }
        });
    </script>
}
