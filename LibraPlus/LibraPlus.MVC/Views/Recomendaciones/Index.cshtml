@{
    ViewData["Title"] = "Recomendaciones de Libros - LibraPlus";
    Layout = "_Layout";
}

<div class="container-beige">
    <h2 class="titulo">Recomendaciones de Libros</h2>

    <button class="btn-agregar" onclick="openRecModal()">📖 Ver Recomendaciones</button>

    <div class="table-container" id="recomendacionesContainer">
        <p>Selecciona un libro que ya hayas leído para ver sugerencias similares.</p>
    </div>
</div>

<!-- -------- MODAL -------- -->
<div class="modal" id="recomendacionModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeRecModal()">×</button>
        <h3>Elige un libro que ya leíste</h3>

        <select id="libroLeidoSelect" required>
            <option value="">Seleccione un libro</option>
        </select>

        <div class="modal-actions">
            <button type="button" class="save" onclick="mostrarRecomendaciones()">Ver Recomendaciones</button>
            <button type="button" class="cancel" onclick="closeRecModal()">Cancelar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allLibros = [];

        // ====== MODAL ======
        function openRecModal() {
            const modal = document.getElementById('recomendacionModal');
            const select = document.getElementById('libroLeidoSelect');
            modal.classList.add("show");

            select.innerHTML = '<option value="">Seleccione un libro</option>';
            allLibros.forEach(l => {
                const opt = document.createElement('option');
                opt.value = l.libroID;
                opt.textContent = l.titulo;
                select.appendChild(opt);
            });
        }

        function closeRecModal() {
            document.getElementById('recomendacionModal').classList.remove("show");
        }

        // ====== CARGA DE LIBROS ======
        async function loadAllLibros() {
            try {
                const resp = await fetch('/Libros/GetLibros');
                if (!resp.ok) throw new Error("No se pudieron cargar los libros");
                allLibros = await resp.json();
            } catch (err) {
                console.error(err);
                showToast("❌ Error al cargar libros: " + err.message, "error");
            }
        }

        // ====== RECOMENDACIONES ======
        function mostrarRecomendaciones() {
            const select = document.getElementById('libroLeidoSelect');
            const seleccionado = allLibros.find(l => l.libroID === parseInt(select.value));
            if (!seleccionado) {
                showToast("⚠️ Debes seleccionar un libro", "error");
                return;
            }

            closeRecModal();

            const generosSeleccionado = seleccionado.genero
                .split(',')
                .map(g => g.trim().toLowerCase());

            const recomendaciones = allLibros.filter(l => {
                if (l.libroID === seleccionado.libroID) return false; // no recomendarse a sí mismo
                const generosLibro = l.genero.split(',').map(g => g.trim().toLowerCase());
                return generosLibro.some(g => generosSeleccionado.includes(g));
            });

            renderRecomendaciones(recomendaciones, seleccionado);
        }

        // ====== RENDERIZAR TABLA ======
        function renderRecomendaciones(lista, base) {
            const container = document.getElementById('recomendacionesContainer');

            if (lista.length === 0) {
                container.innerHTML = `
                    <h3>No encontramos libros similares a <em>${base.titulo}</em> 😕</h3>
                    <p>Prueba con otro título o revisa más adelante.</p>
                `;
                return;
            }

            container.innerHTML = `
                <h3>📚 Libros similares a <em>${base.titulo}</em>:</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Género</th>
                            <th>Tipo</th>
                            <th>Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${lista.map(l => `
                            <tr>
                                <td>${l.titulo}</td>
                                <td>${l.autor}</td>
                                <td>${l.genero}</td>
                                <td>${l.tipo}</td>
                                <td>$${l.precio.toLocaleString('es-AR')}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        // ====== TOAST ======
        function showToast(message, type = "success") {
            const toast = document.createElement("div");
            toast.className = "toast " + (type === "error" ? "error" : "");
            toast.textContent = (type === "error" ? "❌ " : "✅ ") + message;
            document.body.appendChild(toast);
            setTimeout(() => toast.classList.add("show"), 100);
            setTimeout(() => { toast.classList.remove("show"); setTimeout(() => toast.remove(), 300); }, 3000);
        }

        // ====== INICIALIZAR ======
        document.addEventListener('DOMContentLoaded', loadAllLibros);
    </script>
}

